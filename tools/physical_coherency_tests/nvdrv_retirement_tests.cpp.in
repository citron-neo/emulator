@SESSION_METHODS@
struct Handle {std::mutex mutex;bool allocated=true;SessionId session_id{0};u32 id=1;};
struct NvMap {
    std::shared_ptr<Handle> handle=std::make_shared<Handle>();int duplicated=0,pinned=0,unpinned=0,freed=0;
    bool zero_pin=false,throw_pin=false,throw_unpin=false,fail_free=false;
    std::shared_ptr<Handle> GetHandle(u32 id){return id==1?handle:nullptr;}
    void DuplicateHandle(u32,bool){++duplicated;}
    u64 PinHandle(u32,bool){++pinned;if(throw_pin)throw 7;return zero_pin?0:4096;}
    void UnpinHandle(u32){++unpinned;if(throw_unpin)throw 7;}
    std::optional<int> FreeHandle(u32,bool){++freed;return fail_free?std::nullopt:std::optional<int>{1};}
};
struct Container {
    @LIFETIME_DECL@;
    FakeSystem& system;Kernel::KProcess& process;NvMap file;int closed=0;
    bool throw_close=false;std::function<void()> on_close;
    Container(FakeSystem& s,Kernel::KProcess& p):system{s},process{p} {}
    NvMap& GetNvMapFile(){return file;}
    std::optional<SessionLifetime> RetainSession(SessionId){auto p=Kernel::KScopedAutoObject<Kernel::KProcess>::TryOpen(&process);auto b=system.memory.buffer.RetainBackingStorage();if(!p||!b)return {};return SessionLifetime{std::move(*b),std::move(*p),system.kernel.domain};}
    void CloseSession(SessionId,bool){++closed;if(on_close)on_close();if(throw_close)throw 7;}
};
@LIFETIME_METHODS@
}
