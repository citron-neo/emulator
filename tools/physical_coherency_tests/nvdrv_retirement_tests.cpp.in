struct Smmu {Common::FrameMappingDomain frames;auto BeginFrameMappingMutation(){return frames.BeginMutation();}
    int registered=0;Core::Asid RegisterProcess(int*){++registered;return 1;}void Free(u64,size_t){}void UnregisterProcess(Core::Asid){}};
struct Host1x {FakeSystem& system;Smmu smmu;FakeSystem& System(){return system;}Smmu& MemoryManager(){return smmu;}};
struct Impl {Host1x host1x;struct File{std::function<void()> hook;void UnmapAllHandles(SessionId){if(hook)hook();}} file;std::deque<Session> sessions;size_t new_ids=0;u64 next_session_generation{1};std::deque<size_t> id_pool;std::mutex session_guard;explicit Impl(FakeSystem& s):host1x{s,{}} {}};
struct Container {std::unique_ptr<Impl> impl;explicit Container(FakeSystem& s):impl{std::make_unique<Impl>(s)} {}
    using SessionLifetime=NvCore::Container::SessionLifetime;
#define LOG_WARNING(...) ((void)0)
@OPEN_SESSION@
@CLOSE_SESSION@
@RETAIN_SESSION@
};
bool Unlocked(std::mutex& mutex){return std::async(std::launch::async,[&]{if(!mutex.try_lock())return false;mutex.unlock();return true;}).get();}
void Test() {
    FakeSystem system;Kernel::KProcess previous,next;next.pid=2;Container container{system};
    auto owner=Kernel::KScopedAutoObject<Kernel::KProcess>::TryOpen(&previous);
    auto storage=std::make_shared<Allocation>();std::weak_ptr<Allocation> weak=storage;
    container.impl->sessions.emplace_back(SessionId{0},std::move(*owner),1,1,Common::RetainedBackingStorage{storage});
    container.impl->id_pool.push_back(0);storage.reset();previous.Close();
    bool mapper_unlocked=false,process_unlocked=false;
    previous.final=[&]{process_unlocked=Unlocked(container.impl->session_guard);};
    auto& old=container.impl->sessions[0];old.mapper=std::make_unique<NvCore::HeapMapper>();
    old.mapper->released=[&]{mapper_unlocked=Unlocked(container.impl->session_guard);};
    const auto opened=container.OpenSession(&next);
    Require(mapper_unlocked && process_unlocked && previous.refs==0 && weak.expired(),"session reuse released old owners under session_guard");
    {auto lease=container.RetainSession(opened);Require(bool(lease),"live session rejected retained owner");}
    auto stamp=container.impl->host1x.smmu.frames.Capture(4096,4096);
    container.CloseSession(opened,true);
    Require(!container.impl->host1x.smmu.frames.WithUse(*stamp,4096,1,[]{return true;}),
            "shutdown session retained old frame authority");
    Require(!container.RetainSession(opened),"retired session admitted a new owner borrow");
    bool duplicate=false;try{container.CloseSession(opened,true);}catch(const std::runtime_error&){duplicate=true;}
    Require(duplicate && container.impl->sessions[opened.id].ref_count==0,"duplicate session retirement changed reference accounting");
    bool invalid=false;try{container.CloseSession({99},true);}catch(const std::runtime_error&){invalid=true;}
    Require(invalid,"invalid session retirement id was not refused");
    Kernel::KProcess zero;zero.refs=0;const auto registered=container.impl->host1x.smmu.registered;
    bool zero_ref=false;try{(void)container.OpenSession(&zero);}catch(const std::runtime_error&){zero_ref=true;}
    Require(zero_ref && container.impl->host1x.smmu.registered==registered,"session resurrected zero-ref process");
    // Fail before ASID registration when a backing owner cannot be retained.
    system.memory.buffer.storage.reset();const auto before=container.impl->host1x.smmu.registered;
    bool refused=false;try{(void)container.OpenSession(&next);}catch(const std::runtime_error&){refused=true;}
    Require(refused && container.impl->host1x.smmu.registered==before,"session registered ASID without retained backing");
    FakeSystem normal_system;Kernel::KProcess normal_process,replacement_process;Container normal{normal_system};
    const auto normal_id=normal.OpenSession(&normal_process);
    auto normal_stamp=normal.impl->host1x.smmu.frames.Capture(4096,4096);
    normal.impl->file.hook=[&] {
        Require(!normal.impl->host1x.smmu.frames.Capture(4096,4096),
                "session unmap callback reopened frame capture");
    };
    normal.CloseSession(normal_id,false);
    Require(!normal.impl->host1x.smmu.frames.WithUse(*normal_stamp,4096,1,[]{return true;}),
            "ordinary session retained old frame authority");
    const auto replacement=normal.OpenSession(&replacement_process);
    Require(replacement.id==normal_id.id && !normal.RetainSession(normal_id),
            "reused session retained old source owner");
    {auto retained=normal.RetainSession(replacement);Require(bool(retained),"replacement lost retained owner");}
    replacement_process.pid=2;
    Require(!normal.RetainSession(replacement),"PID mismatch retained source owner");
}
}
int main(){GraphicClosed(false);GraphicClosed(true);GraphicPreparationFailure(false);GraphicPreparationFailure(true);GraphicFreeFailure();
    SessionClosed(true);SessionClosed(false);SessionCloseFailure();SlotPublication();EmptyAndStale();SessionOwnerOrder();SessionReuse::Test();FinalProviderRelease(false);FinalProviderRelease(true);ProcessCloseFailure(false);ProcessCloseFailure(true);StaleProcessSnapshot();
    std::cout<<"PASS actual GraphicBuffer/session retirement, retained owners, partial-failure isolation and slot transaction\n";}
