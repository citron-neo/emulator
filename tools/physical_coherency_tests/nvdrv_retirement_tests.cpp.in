struct Module : std::enable_shared_from_this<Module> {
    std::shared_ptr<Common::ProducerDrain> dispatch_domain;
    std::shared_ptr<Common::OwnedRetirementQueue> retirements;FakeSystem& system;NvCore::Container container;
    Module(FakeSystem& s,Kernel::KProcess& p):dispatch_domain{s.kernel.domain},retirements{std::make_shared<Common::OwnedRetirementQueue>(dispatch_domain)},system{s},container{s,p} {}
    std::function<void()> destroyed;
    ~Module(){if(destroyed)destroyed();}
    struct SessionRetirement {std::shared_ptr<std::optional<NvCore::SessionId>> published;Common::OwnedRetirementQueue::Owner record;};
    auto TryEnterDispatch(){return dispatch_domain->EnterCold();}
    NvCore::Container& GetContainer(){return container;}
    auto RetirementQueue() const{return retirements;}
@MODULE_METHODS@
};
struct NVDRV {
    std::shared_ptr<Module> nvdrv;std::optional<Module::SessionRetirement> session_retirement;
    @NVDRV_DESTRUCTOR@
};
