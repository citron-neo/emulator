void Require(bool ok,const char* why){if(!ok){std::cerr<<"FAIL "<<why<<"\n";std::cerr.flush();std::_Exit(91);}}
struct Allocation {bool alive=true;std::function<void()> released;~Allocation(){if(released)released();}};
namespace Common {
namespace Literals {}
struct RetainedBackingStorage {
    std::shared_ptr<Allocation> storage;
    explicit RetainedBackingStorage(std::shared_ptr<Allocation> value):storage{std::move(value)} {}
    RetainedBackingStorage(RetainedBackingStorage&&)=default;
    RetainedBackingStorage& operator=(RetainedBackingStorage&&)=default;
    bool OwnerAlive() const {return storage && storage->alive;}
    const auto& Epoch() const{return storage;}
};
}
namespace Kernel {
struct KProcess {
    int refs=1,memory=0,closes=0;u64 pid=1;bool fail_close=false;std::function<void()> final;
    bool Open(){if(!refs)return false;++refs;return true;}
    void Close(){++closes;if(!--refs){if(final)final();if(fail_close)throw 7;}}
    u64 GetProcessId() const{return pid;}int& GetMemory(){return memory;}
};
template<typename T>struct KScopedAutoObject {
    T* value{};KScopedAutoObject()=default;
    KScopedAutoObject(KScopedAutoObject&& other) noexcept:value{std::exchange(other.value,nullptr)} {}
    KScopedAutoObject& operator=(KScopedAutoObject&& other) noexcept{std::swap(value,other.value);return *this;}
    ~KScopedAutoObject(){if(value)value->Close();}
    static std::optional<KScopedAutoObject> TryOpen(T* value){if(!value||!value->Open())return {};KScopedAutoObject out;out.value=value;return out;}
    T* GetPointerUnsafe() const{return value;}
    T* ReleasePointerUnsafe(){return std::exchange(value,nullptr);}
};
}
namespace Core {using Asid=unsigned;}
struct FakeSystem {
    struct Kernel {std::shared_ptr<Common::ProducerDrain> domain=std::make_shared<Common::ProducerDrain>();const auto& NvdrvDispatchDomain() const{return domain;}} kernel;
    struct Kernel& Kernel(){return kernel;}
    struct Buffer {
        std::shared_ptr<Allocation> storage=std::make_shared<Allocation>();
        std::optional<Common::RetainedBackingStorage> RetainBackingStorage(){if(!storage)return {};return Common::RetainedBackingStorage{storage};}
    };
    struct Memory {Buffer buffer;} memory;
    Memory& DeviceMemory(){return memory;}
};
