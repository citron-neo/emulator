using Service::Nvidia::Module;using Service::android::GraphicBuffer;using Service::android::NvGraphicBuffer;
std::shared_ptr<NvGraphicBuffer> Descriptor(){auto d=std::make_shared<NvGraphicBuffer>();d->buffer_id=1;return d;}
void GraphicClosed(bool fail) {
    FakeSystem system;Kernel::KProcess process;auto module=std::make_shared<Module>(system,process);
    auto entry=module->TryEnterDispatch();auto buffer=GraphicBuffer::TryCreate(module,Descriptor(),*entry);entry.reset();
    Require(buffer && process.refs==2,"GraphicBuffer lost Process/backing owner");
    std::weak_ptr<Module> weak=module;std::weak_ptr<Allocation> backing=system.memory.buffer.storage;
    auto domain=module->dispatch_domain;auto closure=domain->TryClose(64);Require(bool(closure),"graphic close failed");
    if(fail)module->container.file.throw_unpin=true;
    module.reset();system.memory.buffer.storage.reset();buffer.reset();
    Require(!weak.expired() && !backing.expired() && process.refs==2 && weak.lock()->container.file.unpinned==0,
        "closed GraphicBuffer retirement executed or released owners");
    Require(closure->ResumeNoEffects(),"graphic resume failed");auto owner=weak.lock();
    const bool drained=owner->retirements->Drain();
    if(fail) {
        Require(!drained && !domain->TryEnter() && !backing.expired() && process.refs==2 && owner->container.file.unpinned==1 && owner->container.file.freed==0,
            "partial GraphicBuffer retirement released owners or retried");
        Require(!owner->retirements->Drain() && owner->container.file.unpinned==1,"failed GraphicBuffer retirement replayed");
    } else {
        Require(drained && owner->container.file.unpinned==1 && owner->container.file.freed==1 && process.refs==1 && backing.expired(),
            "GraphicBuffer retirement did not release exact owners once");
    }
}
void GraphicPreparationFailure(bool throwing) {
    FakeSystem system;Kernel::KProcess process;auto module=std::make_shared<Module>(system,process);
    module->container.file.zero_pin=!throwing;module->container.file.throw_pin=throwing;
    auto entry=module->TryEnterDispatch();auto buffer=GraphicBuffer::TryCreate(module,Descriptor(),*entry);entry.reset();
    Require(!buffer && !module->dispatch_domain->TryEnter() && process.refs==2 && module->container.file.unpinned==0 && module->container.file.freed==0,
        "failed GraphicBuffer preparation discarded uncertain owners");
}
void GraphicFreeFailure() {
    FakeSystem system;Kernel::KProcess process;auto module=std::make_shared<Module>(system,process);
    auto entry=module->TryEnterDispatch();auto buffer=GraphicBuffer::TryCreate(module,Descriptor(),*entry);entry.reset();
    module->container.file.fail_free=true;buffer.reset();
    Require(!module->dispatch_domain->TryEnter() && process.refs==2 && module->container.file.unpinned==1 && module->container.file.freed==1,
        "refused GraphicBuffer free released owners");
    Require(!module->retirements->Drain() && module->container.file.unpinned==1,"partial free repeated unpin");
}
void SessionClosed(bool published) {
    FakeSystem system;Kernel::KProcess process;auto module=std::make_shared<Module>(system,process);
    auto service=std::make_unique<Service::Nvidia::NVDRV>();service->nvdrv=module;
    auto entry=module->TryEnterDispatch();service->session_retirement=module->PrepareSessionRetirement(&process,*entry);entry.reset();
    Require(bool(service->session_retirement),"session preparation failed");
    if(published)*service->session_retirement->published=Service::Nvidia::NvCore::SessionId{0};
    auto domain=module->dispatch_domain;auto closure=domain->TryClose(64);Require(bool(closure),"session close failed");
    std::weak_ptr<Module> weak=module;std::weak_ptr<Allocation> backing=system.memory.buffer.storage;
    module.reset();system.memory.buffer.storage.reset();service.reset();
    Require(!weak.expired() && !backing.expired() && process.refs==2 && weak.lock()->container.closed==0,
        "closed session retirement executed or released owners");
    Require(closure->ResumeNoEffects(),"session resume failed");auto owner=weak.lock();
    if(published)Require(owner->retirements->Drain() && owner->container.closed==1 && process.refs==1 && backing.expired(),"published session failed retirement");
    else Require(!owner->retirements->Drain() && owner->container.closed==0 && process.refs==2 && !backing.expired(),"unknown session was guessed or released");
}
void SlotPublication() {
    FakeSystem system;Kernel::KProcess process;auto module=std::make_shared<Module>(system,process);
    Service::android::BufferQueueProducer producer{module};
    auto old=std::make_shared<GraphicBuffer>(1,1,Service::android::PixelFormat{},0);producer.slots[0].graphic_buffer=old;
    auto closure=module->dispatch_domain->TryClose(64);Require(bool(closure),"slot close failed");
    Require(producer.SetPreallocatedBuffer(0,Descriptor())==Service::android::Status::WouldBlock && producer.slots[0].graphic_buffer==old && module->container.file.duplicated==0,
        "refused GraphicBuffer publication destroyed old slot");
    Require(closure->ResumeNoEffects(),"slot resume failed");module->container.file.zero_pin=true;
    Require(producer.SetPreallocatedBuffer(0,Descriptor())==Service::android::Status::WouldBlock && producer.slots[0].graphic_buffer==old,
        "failed GraphicBuffer preparation destroyed old slot");
}
void EmptyAndStale() {
    FakeSystem system;Kernel::KProcess process;auto module=std::make_shared<Module>(system,process);
    Service::android::BufferQueueProducer producer{module};
    Require(producer.SetPreallocatedBuffer(0,{})==Service::android::Status::NoError && producer.slots[0].graphic_buffer &&
        producer.slots[0].graphic_buffer->BufferId()==0 && module->container.file.duplicated==0 && process.refs==1,
        "empty GraphicBuffer descriptor lost supported behavior");
    auto entry=module->TryEnterDispatch();auto buffer=GraphicBuffer::TryCreate(module,Descriptor(),*entry);entry.reset();
    system.memory.buffer.storage->alive=false;buffer.reset();
    Require(module->container.file.unpinned==0 && module->container.file.freed==0 && process.refs==2 && !module->dispatch_domain->TryEnter(),
        "stale GraphicBuffer backing permitted owner callbacks");
}
void SessionCloseFailure() {
    FakeSystem system;Kernel::KProcess process;auto module=std::make_shared<Module>(system,process);
    auto service=std::make_unique<Service::Nvidia::NVDRV>();service->nvdrv=module;
    auto entry=module->TryEnterDispatch();service->session_retirement=module->PrepareSessionRetirement(&process,*entry);entry.reset();
    *service->session_retirement->published=Service::Nvidia::NvCore::SessionId{0};module->container.throw_close=true;
    service.reset();std::weak_ptr<Module> weak=module;std::weak_ptr<Allocation> backing=system.memory.buffer.storage;
    Require(!module->retirements->Drain() && module->container.closed==1,"partial session close was replayed");
    module.reset();system.memory.buffer.storage.reset();
    Require(!weak.expired() && !backing.expired() && process.refs==2 && !weak.lock()->dispatch_domain->TryEnter(),
        "partial session close released uncertain owners");
}
void FinalProviderRelease(bool session) {
    FakeSystem system;Kernel::KProcess process;auto module=std::make_shared<Module>(system,process);
    auto domain=module->dispatch_domain;bool counted=false;
    module->destroyed=[&]{auto closure=domain->TryClose(64);counted=closure && closure->Poll()==Common::ProducerDrain::Result::Pending;};
    std::weak_ptr<Module> weak=module;std::weak_ptr<Common::OwnedRetirementQueue> queue=module->retirements;
    auto entry=module->TryEnterDispatch();
    if(session){
        auto service=std::make_unique<Service::Nvidia::NVDRV>();service->nvdrv=module;
        service->session_retirement=module->PrepareSessionRetirement(&process,*entry);
        *service->session_retirement->published=Service::Nvidia::NvCore::SessionId{0};
        entry.reset();module.reset();service.reset();
    }else{
        auto buffer=GraphicBuffer::TryCreate(module,Descriptor(),*entry);entry.reset();module.reset();buffer.reset();
    }
    Require(counted && weak.expired() && queue.expired(),session?
        "session provider release escaped retirement entry":"GraphicBuffer provider release escaped retirement entry");
}
void SessionOwnerOrder() {
    using namespace Service::Nvidia::NvCore;
    Kernel::KProcess old_process,new_process;auto old_storage=std::make_shared<Allocation>();auto new_storage=std::make_shared<Allocation>();
    auto a=Kernel::KScopedAutoObject<Kernel::KProcess>::TryOpen(&old_process);auto b=Kernel::KScopedAutoObject<Kernel::KProcess>::TryOpen(&new_process);
    Session old{{0},std::move(*a),1,1,Common::RetainedBackingStorage{old_storage}};
    Session replacement{{1},std::move(*b),2,2,Common::RetainedBackingStorage{new_storage}};
    std::weak_ptr<Allocation> weak=old_storage;old_storage.reset();old_process.Close();
    bool legal=false;old.mapper=std::make_unique<HeapMapper>();old.mapper->released=[&]{legal=old_process.refs>0&&!weak.expired();};
    old=std::move(replacement);
    Require(legal && old_process.refs==0 && weak.expired(),"session assignment released backing before mapper");
}
void ProcessCloseFailure(bool snapshot) {
    using namespace Service::Nvidia::NvCore;
    Kernel::KProcess process;auto domain=std::make_shared<Common::ProducerDrain>();auto storage=std::make_shared<Allocation>();std::weak_ptr<Allocation> weak=storage;
    auto owner=Kernel::KScopedAutoObject<Kernel::KProcess>::TryOpen(&process);process.Close();process.fail_close=true;
    if(snapshot){
        std::optional<Container::SessionLifetime> lifetime;
        lifetime.emplace(Common::RetainedBackingStorage{storage},std::move(*owner),domain);storage.reset();lifetime.reset();
    }else{
        auto failure=std::make_unique<ProcessReleaseFailure>();failure->domain=domain;
        std::optional<Session> session;
        session.emplace(SessionId{0},std::move(*owner),1,1,Common::RetainedBackingStorage{storage},std::move(failure));storage.reset();session.reset();
    }
    Require(!weak.expired() && process.refs==0 && process.closes==2,"failed Process close lost backing or retried zero-ref owner");
    Require(!domain->TryEnter(),"failed Process close granted admission");
    auto* record=failed_process_releases.load();
    Require(record && record->domain==domain && record->process_identity==&process,"failed Process close lost quarantine bookkeeping");
}
void StaleProcessSnapshot() {
    using namespace Service::Nvidia::NvCore;
    Kernel::KProcess process;auto domain=std::make_shared<Common::ProducerDrain>();auto storage=std::make_shared<Allocation>();std::weak_ptr<Allocation> weak=storage;
    auto owner=Kernel::KScopedAutoObject<Kernel::KProcess>::TryOpen(&process);process.Close();
    std::optional<Container::SessionLifetime> lifetime;
    lifetime.emplace(Common::RetainedBackingStorage{storage},std::move(*owner),domain);
    storage->alive=false;storage.reset();lifetime.reset();
    Require(process.closes==1 && process.refs==1 && !weak.expired() && !domain->TryEnter(),"stale Process snapshot dereferenced retired Kernel owner");
}
