static void Require(bool b,const char* s) {
    if(!b) {std::fprintf(stderr,"FAIL %s\n",s);std::fflush(stderr);std::_Exit(91);}
}
struct Gate {
    std::mutex mutex;std::condition_variable cv;bool set{};
    void Set(){std::scoped_lock l{mutex};set=true;cv.notify_all();}
    void Wait(){std::unique_lock l{mutex};Require(cv.wait_for(l,5s,[&]{return set;}),"rendezvous timeout");}
};
static std::string mode;
static std::atomic<bool> audio_joined{},gpu_drained{};
static std::atomic<unsigned> joins{},callbacks{},effects{},service_joins{};
static std::atomic<bool> service_work_active{};
static Gate service_lock_held,callback_lock_wait;
static Gate entered,release_callback,closing,joining,reg_entered,reg_release,publish_entered,publish_release;
static Gate worker_paused;
void ObserveHostPause(){worker_paused.Set();}
static bool block_registration{},block_publication{};
struct Target {std::string kind;bool live=true;unsigned active{},calls{};};
static std::mutex targets_mutex;
static std::map<void*,Target> targets;
static std::map<std::string,void*> addresses;
static void ConstructTarget(void* p,const char* kind) {
    std::scoped_lock l{targets_mutex};targets[p]=Target{kind};addresses[kind]=p;
}
static void EnterTarget(void* p) {
    {std::scoped_lock l{targets_mutex};auto& t=targets.at(p);Require(t.live,"raw callback used retired target");++t.active;++t.calls;}
    ++callbacks;entered.Set();
    if(mode!="both") release_callback.Wait();
}
static void LeaveTarget(void* p) {std::scoped_lock l{targets_mutex};Require(targets.at(p).live,"target disappeared inside callback");--targets.at(p).active;}
static void InjectTargetFailure() {if(mode.ends_with("failure")&&!mode.ends_with("join-failure")){++effects;throw 7;}}
static void RetireTarget(void* p) {
    std::scoped_lock l{targets_mutex};auto& t=targets.at(p);
    Require(service_joins>0,"service target lost its server owner path");
    Require(t.active==0,"target retired before callback drain");
    Require(audio_joined,"target retired before Audio worker join");
    t.live=false;std::fprintf(stderr,"TARGET_RETIRED %s\n",t.kind.c_str());
}
static void ObserveAudioClose(){Require(gpu_drained,"Audio join preceded native GPU drain");closing.Set();}
static void BeforeAudioJoin(){Require(!service_work_active,"Audio join preceded service work drain");joining.Set();if(mode.ends_with("join-failure"))throw std::runtime_error("injected join failure");}
static void BeforeTargetLock(std::recursive_mutex& mutex) {
    if(mode.ends_with("service-active")) {
        Require(!mutex.try_lock(),"service work did not hold target mutex");callback_lock_wait.Set();
    }
}
[[maybe_unused]] static void ObserveAudioJoined(){audio_joined=true;++joins;}
[[maybe_unused]] static void BeforeRegistrationLock(){if(block_registration){reg_entered.Set();reg_release.Wait();}}
[[maybe_unused]] static void BeforeRegistrationLockAfterCheck(){if(block_registration){reg_entered.Set();reg_release.Wait();}}
static void BeforeRegistrationPublish(){if(block_publication){publish_entered.Set();publish_release.Wait();}}
static void BeforeAudioReset(){}
