class ServerManager {
    std::vector<SessionRequestHandlerFactory> ports;
    std::stop_source m_stop_source;
    struct Wakeup{void Signal(){}} wakeup;
    Wakeup* m_wakeup_event=&wakeup;
    struct Stopped{void Wait(){++service_joins;}} m_stopped;
    std::vector<std::jthread> m_threads;
public:
    explicit ServerManager(Core::System&){}
    // Kernel port/IPC worker waits are fixtures; factory ownership is real code below.
    ~ServerManager(){
@SERVER_JOIN@
    }
    @SERVICE_HOOK_DECL@
    void StartServiceWork(std::recursive_mutex& mutex) {
        auto token=m_stop_source.get_token();
        m_threads.emplace_back([&mutex,token]{
            std::scoped_lock l{mutex};service_work_active=true;service_lock_held.Set();
            while(!token.stop_requested()) std::this_thread::yield();
            service_work_active=false;
        });
    }
    Result RegisterNamedService(const std::string&,std::shared_ptr<SessionRequestHandler>&&,u32);
    Result RegisterNamedService(const std::string&,SessionRequestHandlerFactory&& f,u32){ports.push_back(std::move(f));return ResultSuccess;}
};
@REGISTER@
}
