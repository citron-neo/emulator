Core::System::System():audio_core{std::make_unique<::AudioCore::AudioCore>(*this)}{}
Core::System::~System()=default;

template<class T>static T Ready(std::future<T>& f) {Require(f.wait_for(5s)==std::future_status::ready,"operation timeout");return f.get();}
using Service::ServerManager;
static void Install(Core::System& system,Service::ServerManager& server,const std::string& direction) {
    std::shared_ptr<Service::SessionRequestHandler> service;
    if(direction=="out") service=std::make_shared<Service::Audio::IAudioOutManager>(system);
    else service=std::make_shared<Service::Audio::IAudioInManager>(system);
    Require(server.RegisterNamedService(direction,std::move(service),64)==ResultSuccess,"actual handler registration failed");
    // No client shared owner remains: the real handler-factory capture retains the service.
    service.reset();
    void* target;{std::scoped_lock l{targets_mutex};target=addresses.at(direction);}
    if(direction=="out") Require(static_cast<AudioCore::AudioOut::Manager*>(target)->LinkToManager()==ResultSuccess,"out target link failed");
    else Require(static_cast<AudioCore::AudioIn::Manager*>(target)->LinkToManager()==ResultSuccess,"in target link failed");
}
int main(int argc,char**argv) {
    Require(argc==2,"expected case");mode=argv[1];std::atexit([]{std::fprintf(stderr,"ATEXIT\n");});
    Core::System system;
    if(mode.starts_with("registration")) {
        // Single owning teardown caller; setter may race that close.
        gpu_drained=true;std::atomic<unsigned> calls{};
        block_registration=mode=="registration-loses";
        block_publication=mode=="registration-wins";
        auto registering=std::async(std::launch::async,[&]{return system.AudioCore().GetAudioManager().SetOutManager([&]{++calls;});});
        if(block_registration) {
            reg_entered.Wait();system.AudioCore().Shutdown();reg_release.Set();
            Require(Ready(registering)==Service::Audio::ResultOperationFailed,"closed registration returned success");
            Require(calls==0,"closed registration invoked callback");
        } else {
            publish_entered.Wait();
            auto stopping=std::async(std::launch::async,[&]{system.AudioCore().Shutdown();});
            closing.Wait();Require(stopping.wait_for(0ms)!=std::future_status::ready,"close bypassed admitted registration lock");
            publish_release.Set();Require(Ready(registering)==ResultSuccess,"admitted registration lost success");Ready(stopping);
        }
        block_registration=false;block_publication=false;
        Require(system.AudioCore().GetAudioManager().SetInManager([]{})==Service::Audio::ResultOperationFailed,"shutdown reopened registration");
        system.ShutdownSlice();Require(joins==1,"repeat shutdown joined worker twice");
    } else {
        std::optional<Common::ProducerDrain::Closure> closed;
        if(mode.ends_with("paused")) {auto c=system.kernel.domain->TryClose(256);Require(bool(c),"callback close refused");closed.emplace(std::move(*c));}
@SERVER_SETUP@
@DRAIN_FAILURE_SETUP@
        auto* registry=server_manager.get();system.kernel.server_managers.push_back(std::move(server_manager));
        if(mode=="both") {Install(system,*registry,"out");Install(system,*registry,"in");}
        else Install(system,*registry,mode.starts_with("in")?"in":"out");
        if(closed) worker_paused.Wait();
        if(!closed) entered.Wait();
        if(mode.ends_with("service-active")) {
            void* target;{std::scoped_lock l{targets_mutex};target=addresses.at(mode.starts_with("in")?"in":"out");}
            if(mode.starts_with("in")) registry->StartServiceWork(static_cast<AudioCore::AudioIn::Manager*>(target)->mutex);
            else registry->StartServiceWork(static_cast<AudioCore::AudioOut::Manager*>(target)->mutex);
            service_lock_held.Wait();release_callback.Set();callback_lock_wait.Wait();
        }
        if(mode=="both") {
            // The registry targets and real slots are both installed; normal callbacks may run.
            release_callback.Set();
        }
        auto stopping=std::async(std::launch::async,[&]{system.ShutdownSlice();});
        if(!closed&&mode!="both"&&!mode.ends_with("service-active")) {
            joining.Wait();Require(stopping.wait_for(0ms)!=std::future_status::ready,"owner teardown skipped active Audio join");
            {std::scoped_lock l{targets_mutex};for(auto&[p,t]:targets)Require(t.live,"service target released while join pending");}
            release_callback.Set();
        }
        Ready(stopping);
        Require(audio_joined&&joins==1,"terminal Audio worker did not join exactly once");
        {std::scoped_lock l{targets_mutex};for(auto&[p,t]:targets)Require(!t.live&&t.active==0,"service target failed final retirement");}
        if(closed) Require(callbacks==0,"closed callback domain invoked raw target");
        if(mode.ends_with("failure")) Require(effects==1&&!system.kernel.domain->TryClose(8),"partial callback failure lost Unknown seal");
    }
    std::cout<<"PASS audio-service-owner "<<mode<<"\n";
}
