@CTRL@
class UnusedDevice:public nvdevice {public:
 template<class...T>UnusedDevice(Core::System&s,T&&...):nvdevice{s}{}
 NvResult Ioctl1(DeviceFD,Ioctl,std::span<const u8>,std::span<u8>)override{return NvResult::NotImplemented;}
 NvResult Ioctl2(DeviceFD,Ioctl,std::span<const u8>,std::span<const u8>,std::span<u8>)override{return NvResult::NotImplemented;}
 NvResult Ioctl3(DeviceFD,Ioctl,std::span<const u8>,std::span<u8>,std::span<u8>)override{return NvResult::NotImplemented;}
 void OnOpen(NvCore::SessionId,DeviceFD)override{}void OnClose(DeviceFD)override{}};
using nvhost_as_gpu=UnusedDevice;using nvhost_gpu=UnusedDevice;using nvhost_ctrl_gpu=UnusedDevice;using nvmap=UnusedDevice;
