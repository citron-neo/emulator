static void Require(bool b,const char*s){if(!b){std::cerr<<"FAIL "<<s<<"\n";std::cerr.flush();std::_Exit(91);}}
#define LOG_DEBUG(...) ((void)0)
#define LOG_INFO(...) ((void)0)
#define LOG_ERROR(...) ((void)0)
#define LOG_TRACE(...) ((void)0)
#define LOG_WARNING(...) ((void)0)
#define LOG_CRITICAL(...) ((void)0)
#define ASSERT(x) Require(bool(x),"native fixture assertion")
#define ASSERT_MSG(x,...) ASSERT(x)
#define UNIMPLEMENTED_MSG(...) Require(false,"unexpected native fixture route")
struct Gate {std::mutex m;std::condition_variable cv;bool ready{};
 void Set(){std::scoped_lock l{m};ready=true;cv.notify_all();}
 void Wait(){std::unique_lock l{m};Require(cv.wait_for(l,5s,[&]{return ready;}),"rendezvous timeout");}};
static Gate signal_entered,signal_release,cancel_entered;
static std::string mode;
static std::atomic<unsigned> active_signals{},signals{},freed_events{},module_ends{};
static std::atomic<unsigned> nonzero_cancels{};
static thread_local unsigned host_guard_depth{};
struct ObservedHostGuard {ObservedHostGuard(){++host_guard_depth;}~ObservedHostGuard(){--host_guard_depth;}};
static std::mutex observation_mutex;
static std::set<void*> destroyed_devices;
static std::map<u64,void*> queued_actions;
static thread_local void* registering_owner{};
static std::function<void()> register_hook;
static void ObserveRegisterOwner(void*p){registering_owner=p;if(register_hook)register_hook();}
static void ObserveQueued(u64 id){std::scoped_lock l{observation_mutex};queued_actions[id]=registering_owner;}
static void ObserveRemoved(u64 id){std::scoped_lock l{observation_mutex};queued_actions.erase(id);}
static void ObserveDeviceDestruction(void*){}
static void ObserveDeviceDestroyed(void*p){std::scoped_lock l{observation_mutex};destroyed_devices.insert(p);}
static void ObserveRawCallback(void*p){std::scoped_lock l{observation_mutex};Require(!destroyed_devices.contains(p),"queued callback used retired target");}
static void BeforeDeregister(u64 id){if(id){++nonzero_cancels;cancel_entered.Set();if(mode=="cancel-failure")throw std::runtime_error("injected cancel failure");}}
static void ModuleDestructionBegin(){Require(host_guard_depth==0,"final Module owner released under Host1x guard");}
static void ModuleDestructionEnd(){++module_ends;std::cerr<<"MODULE_DESTROYED\n";}
namespace Common {namespace Literals{}
class HostMemory {public:
 std::shared_ptr<std::array<u8,4096>> storage=std::make_shared<std::array<u8,4096>>();
 std::shared_ptr<const GuestBackingEpoch> epoch=std::make_shared<GuestBackingEpoch>();
 auto RetainBackingStorage(){return storage?std::optional<RetainedBackingStorage>{RetainedBackingStorage{storage,epoch,4096}}:std::nullopt;}
};}
namespace Kernel {
class KProcess {public:std::atomic<unsigned> refs{1};int memory{};u64 GetProcessId()const{return 7;}int& GetMemory(){return memory;}
 bool Open(){++refs;return true;}void Close(){Require(refs>1,"process reference underflow");--refs;}};
template<class T>class KScopedAutoObject {T*p{};public:
 KScopedAutoObject()=default;KScopedAutoObject(KScopedAutoObject&&r)noexcept:p{std::exchange(r.p,nullptr)}{}
 KScopedAutoObject&operator=(KScopedAutoObject&&r)noexcept{std::swap(p,r.p);return *this;}
 ~KScopedAutoObject(){if(p)p->Close();}
 static auto TryOpen(T*p){std::optional<KScopedAutoObject> r; if(p&&p->Open()){r.emplace();r->p=p;}return r;}
 T*GetPointerUnsafe()const{return p;}T*ReleasePointerUnsafe(){return std::exchange(p,nullptr);}};
class KEvent {public:bool live=true;void* owner{};
 void Signal(){Require(live,"callback signalled freed event");++active_signals;
  if(mode=="active"||mode=="clear-active"||mode=="concurrent-clear-active"||mode=="multi-events-active"||mode=="retirement-close-active"||mode=="closed-active"){signal_entered.Set();signal_release.Wait();}
  if(mode=="callback-failure"){--active_signals;throw 7;}
  ++signals;--active_signals;}
 void Clear(){Require(active_signals==0,"clear overtook active callback");Require(live,"clear freed event");}};
}
namespace Core {class System;using Asid=unsigned;}
struct Smmu {
 struct Mutation{void Complete(){}};Mutation BeginFrameMappingMutation(){return {};}
 unsigned RegisterProcess(int*){return 1;}void UnregisterProcess(unsigned){}void Free(u64,size_t){}
};
namespace Tegra::Host1x {
class Host1x {Core::System&sys;SyncpointManager sync;Smmu memory;public:
 explicit Host1x(Core::System&s):sys{s}{}Core::System&System(){return sys;}
 SyncpointManager&GetSyncpointManager(){return sync;}Smmu&MemoryManager(){return memory;}};
}
namespace Core {class System {public:
 struct KernelShell {std::shared_ptr<Common::ProducerDrain> domain=std::make_shared<Common::ProducerDrain>();const auto&NvdrvDispatchDomain(){return domain;}} kernel;
 struct Memory{Common::HostMemory buffer;} memory;
 struct Gpu {struct Allocation {std::shared_ptr<int>channel;Common::TerminalIngress::Entry publication;};
  std::optional<Allocation>AllocateChannel(){return std::nullopt;}} gpu;
 Tegra::Host1x::Host1x host{*this};
 auto&Kernel(){return kernel;}auto&DeviceMemory(){return memory;}auto&Host1x(){return host;}auto&GPU(){return gpu;}
 auto StallApplication(){return std::unique_lock<std::mutex>{stall};}void UnstallApplication(){}
 private:std::mutex stall;
};}
namespace KernelHelpers {
class ServiceContext {std::vector<std::unique_ptr<Kernel::KEvent>> events;public:
 ServiceContext(Core::System&,const char*){}~ServiceContext(){std::cerr<<"CONTEXT_DESTROYED\n";}
 Kernel::KEvent*CreateEvent(std::string){events.push_back(std::make_unique<Kernel::KEvent>());return events.back().get();}
 void CloseEvent(Kernel::KEvent*e){Require(active_signals==0,"event freed during active Host1x callback");Require(e->live,"event freed twice");e->live=false;++freed_events;}
};}
