namespace Service::Nvidia {
@PROVIDER@
@MODULE_METHODS@
class NVDRV {public:
 std::shared_ptr<Module>nvdrv;std::optional<Module::SessionRetirement> session_retirement;
 NVDRV(std::shared_ptr<Module>m,Kernel::KProcess&p):nvdrv{std::move(m)}{
  auto entry=nvdrv->TryEnterDispatch();Require(bool(entry),"session dispatch refused");
  auto prepared=nvdrv->PrepareSessionRetirement(&p,*entry);Require(bool(prepared),"retirement preparation refused");
  session_retirement.emplace(std::move(*prepared));
  *session_retirement->published=nvdrv->GetContainer().OpenSession(&p);
 }
 ~NVDRV();
};
@NVDRV_DTOR@
}
@SERIALIZATION@
@CTRL_METHODS@
@SYNC@
using Service::Nvidia::Module;using Service::Nvidia::NVDRV;using Service::Nvidia::NvResult;using Service::Nvidia::Ioctl;
template<class P>static NvResult IoctlCall(Module&m,int fd,u32 command,P&params){
 Ioctl ioctl{};ioctl.cmd.Assign(command);ioctl.group.Assign(0);ioctl.length.Assign(sizeof(P));
 auto in=std::span<const u8>{reinterpret_cast<const u8*>(&params),sizeof(P)};
 auto out=std::span<u8>{reinterpret_cast<u8*>(&params),sizeof(P)};return m.Ioctl1(fd,ioctl,in,out);
}
static void Queue(Module&m,int fd,u32 slot,u32 sync=2,u32 threshold=1){
 struct Reg{u32 slot;} reg{slot};Require(IoctlCall(m,fd,0x1f,reg)==NvResult::Success,"event registration failed");
 struct Wait{Service::Nvidia::NvFence fence;u32 timeout,value;}wait{{static_cast<s32>(sync),threshold},100,slot};
 Require(IoctlCall(m,fd,0x1e,wait)==NvResult::Timeout,"queued wait reported completion");
}
static void Clear(Module&m,int fd,u32 slot=0){struct Params{u32 slot;}params{slot};
 Require(IoctlCall(m,fd,0x1c,params)==NvResult::Success,"event clear failed");}
template<class T>static T Ready(std::future<T>&f){Require(f.wait_for(5s)==std::future_status::ready,"operation timeout");return f.get();}
int main(int argc,char**argv){
 Require(argc==2,"expected case");mode=argv[1];std::atexit([]{std::cerr<<"ATEXIT\n";});
 Core::System system;Kernel::KProcess process;
 auto module=std::make_shared<Module>(system);auto facade=std::make_unique<NVDRV>(module,process);
 auto queue=module->RetirementQueue();auto domain=system.Kernel().NvdrvDispatchDomain();
 auto sid=**facade->session_retirement->published;
 int fd=module->Open("/dev/nvhost-ctrl",sid);Require(fd>=0,"actual device open failed");
 if(mode=="immediate")register_hook=[&]{system.Host1x().GetSyncpointManager().IncrementHost(2);};
 Queue(*module,fd,0,mode=="multi-events-active"?3:2);
 if(mode=="multi-events-active")Queue(*module,fd,1);
 register_hook={};
 int second=-1;if(mode=="multiple"){second=module->Open("/dev/nvhost-ctrl",sid);Queue(*module,second,0);}
 std::weak_ptr<Module>weak=module;std::weak_ptr<std::array<u8,4096>>backing=system.memory.buffer.storage;
 system.memory.buffer.storage.reset();
 auto&sync=system.Host1x().GetSyncpointManager();
 if(mode=="completed")sync.IncrementHost(2);
 if(mode=="callback-failure"){bool failed=false;try{sync.IncrementHost(2);}catch(...){failed=true;}Require(failed,"callback did not expose failure");}
 if(mode=="repeat-clear-rearm"){
  Clear(*module,fd);Clear(*module,fd);
  Require(nonzero_cancels==1,"repeated clear retained cancelled handle");
  Queue(*module,fd,0,2,2);
  sync.IncrementHost(2);Require(signals==0,"cancelled callback affected rearmed event");
  sync.IncrementHost(2);Require(signals==1,"rearmed callback did not run exactly once");
  Clear(*module,fd);Clear(*module,fd);
  Require(nonzero_cancels==2,"completed clear retained stale handle");
  module.reset();facade.reset();Require(freed_events==2,"rearmed KEvent retired other than once");
 }else if(mode=="last-owner-complete"||mode=="last-owner-cancel"){
  auto held=std::shared_ptr<NVDRV>(facade.release());
  auto handle=sync.RegisterHostAction(3,1,[held]{});held.reset();module.reset();
  Require(!weak.expired(),"queue capture lost final facade owner");
  if(mode=="last-owner-complete")sync.IncrementHost(3);
  else {sync.DeregisterHostAction(3,handle);sync.DeregisterHostAction(3,handle);}
 }else if(mode=="closed-active"){
  auto increment=std::async(std::launch::async,[&]{sync.IncrementHost(2);});signal_entered.Wait();
  auto closed=domain->TryClose(64);
  Require(closed&&closed->Poll()==Common::ProducerDrain::Result::DrainedSubset&&active_signals==1,
   "missing active Host1x callback subset counterexample");
  Require(Common::ProducerDrain::GuestBackingAdmission()==Common::ProducerDrain::Result::Unknown,
   "untracked Host1x callback granted guest admission");
  module.reset();facade.reset();
  Require(!weak.expired()&&freed_events==0&&process.refs>1&&!backing.expired(),
   "closed active callback lost deferred owner graph");
  std::cout<<"WITNESS dispatch DrainedSubset with active Host1x callback; admission Unknown\n";
  // Reopen only this fixture's managed subset, not whole-guest/native exclusion.
  Require(closed->ResumeNoEffects(),"subset fixture resume failed");
  auto retiring=std::async(std::launch::async,[&]{Require(queue->Drain(),"active deferred retirement failed");});
  cancel_entered.Wait();auto joined=domain->TryClose(64);
  Require(joined&&joined->Poll()==Common::ProducerDrain::Result::Pending,
   "deferred final release escaped dispatch closure");
  signal_release.Set();Ready(increment);Ready(retiring);
  Require(joined->Poll()==Common::ProducerDrain::Result::DrainedSubset&&weak.expired()&&active_signals==0,
   "deferred final release did not drain its owner graph");
  Require(joined->ResumeNoEffects(),"joined fixture subset resume failed");
 }else if(mode=="closed-deferred"){
  auto closed=domain->TryClose(64);Require(bool(closed)&&closed->Poll()==Common::ProducerDrain::Result::DrainedSubset,"dispatch subset did not close");
  {std::scoped_lock l{observation_mutex};Require(!queued_actions.empty(),"closed dispatch hid queued Host1x work");}
  module.reset();facade.reset();Require(!weak.expired(),"deferred retirement lost Module owner");
  Require(process.refs>1&&!backing.expired(),"deferred retirement lost session/backing");
  // Managed dispatch gate only; no callback or native effect ran during this hold.
  Require(closed->ResumeNoEffects(),"managed dispatch resume failed");Require(queue->Drain(),"deferred retirement did not drain");
 }else if(mode=="concurrent-clear-active"){
  auto increment=std::async(std::launch::async,[&]{sync.IncrementHost(2);});signal_entered.Wait();
  auto first=std::async(std::launch::async,[&]{Clear(*module,fd);});cancel_entered.Wait();
  auto second_clear=std::async(std::launch::async,[&]{Clear(*module,fd);});
  signal_release.Set();Ready(increment);Ready(first);Ready(second_clear);
  Require(nonzero_cancels==1&&signals==1&&freed_events==0,
   "concurrent clears reused a callback or freed its event");
  module.reset();facade.reset();Require(freed_events==1,"concurrent clear event not retired once");
 }else if(mode=="clear-active"){
  auto increment=std::async(std::launch::async,[&]{sync.IncrementHost(2);});signal_entered.Wait();
  auto clearing=std::async(std::launch::async,[&]{struct Clear{u32 id;}params{0};
   Require(IoctlCall(*module,fd,0x1c,params)==NvResult::Success,"clear failed");});
  cancel_entered.Wait();Require(freed_events==0,"clear freed active event");
  signal_release.Set();Ready(increment);Ready(clearing);
  Require(module->Close(fd)==NvResult::Success,"clear fd close failed");
  module.reset();facade.reset();
 }else if(mode=="active"||mode=="multi-events-active"||mode=="retirement-close-active"){
  auto increment=std::async(std::launch::async,[&]{sync.IncrementHost(2);});signal_entered.Wait();
  module.reset();auto retiring=std::async(std::launch::async,[&]{facade.reset();});
  cancel_entered.Wait();Require(freed_events==0&&process.refs>1&&!backing.expired(),"active callback lost owner graph before join");
  auto closing=mode=="retirement-close-active"?domain->TryClose(64):std::nullopt;
  if(mode=="retirement-close-active"){
   Require(closing&&closing->Poll()==Common::ProducerDrain::Result::Pending,
    "final retirement release escaped dispatch closure");
  }
  signal_release.Set();Ready(increment);Ready(retiring);
  if(closing){Require(closing->Poll()==Common::ProducerDrain::Result::DrainedSubset&&weak.expired(),
   "final owner release did not finish before dispatch drain");
   Require(closing->ResumeNoEffects(),"final owner fixture subset resume failed");}
 }else if(mode=="multiple"){
  Require(module->Close(fd)==NvResult::Success,"first fd close failed");sync.IncrementHost(2);
  Require(signals==1,"device cancellation removed another device's action");module.reset();facade.reset();
 }else if(mode=="fd-close"){
  Require(module->Close(fd)==NvResult::Success,"fd close failed");sync.IncrementHost(2);Require(signals==0,"closed fd kept raw callback");
  module.reset();facade.reset();
 }else{module.reset();facade.reset();}
 Require(weak.expired()&&module_ends==1,"last Module owner did not retire");
 Require(process.refs==1&&backing.expired(),"session/backing survived proven last use");
 auto before=signals.load();sync.IncrementHost(2);Require(signals==before,"retired callback was replayed");
 {std::scoped_lock l{observation_mutex};Require(queued_actions.empty(),"retired device left queued callback");}
 std::cout<<"PASS nvhost-owner "<<mode<<"\n";
}
