// Planner query and admission use real extracted production bodies; dispatch/failures are simulated.
void TestReconciliationPlanner() {
    using S=Vulkan::Scheduler;using C=Vulkan::TransferContent;using Planner=Vulkan::BoundedReconciliationPlanner;
    using State=Planner::State;using Reason=Planner::Reason;using R=Planner::RootSpan;
    enum Mode {Good,Conflict,Ambiguous,SourceStale,ComplementStale,Remap,Retired,MissingSync,WrongQueue,Pending,
        UnknownProducer,WrongReceipt,LeaseSource,LeaseComplement,LeaseRemap,LeaseRetire,LeaseSync,
        PartialOne,PartialTwo,SubmitFailure,UncertainSubmit,QueueIntervened,MissingOutputSync,PteMismatch,Count};
    static_assert(Count==24);
    struct Byte {u32 root;u64 offset;u8 value;};
    for(int mode=0;mode<Count;++mode) {
        auto s=std::make_unique<Scenario>();Vulkan::StorageObserverHarness observation{s->scheduler,s->runtime};
        std::array<std::unique_ptr<Vulkan::Buffer>,3> owners;std::vector<S::TransferBuffer> targets;
        std::vector<C::Command> initialize;std::array<std::array<Byte,64>,3> oracle;
        for(u32 slot=0;slot<3;++slot) {
            owners[slot]=std::make_unique<Vulkan::Buffer>(s->runtime,A+slot*131072,4096);
            targets.push_back({*owners[slot]->PinStagedRepresentation(0,64),s->runtime.PhysicalIdentityForBinding(*owners[slot],0,64)});
            const u8 value=slot?slot*10:99;initialize.push_back({C::Kind::Fill,slot,0,0,0,64,u32(value)*0x01010101u});
            for(u64 b=0;b<64;++b) oracle[slot][b]={slot,b,value};
        }
        const auto seed=[&](u32 dst,u32 src,u64 to,u64 from,u64 size) {
            initialize.push_back({C::Kind::Copy,dst,src,to,from,size});const auto before=oracle[src];
            for(u64 b=0;b<size;++b) oracle[dst][to+b]=before[from+b];
        };
        seed(0,0,8,0,8);seed(0,0,56,32,8);
        if(mode==Ambiguous) seed(1,0,0,0,64);
        seed(2,1,24,4,8);seed(2,0,48,16,8);
        const auto anchor=s->scheduler.RecordTransferBatch(targets,initialize);assert(anchor);
        if(mode!=Pending) {s->scheduler.RunWorker();s->gpu.Complete();}
        const auto old=oracle[2];
        std::vector<R> source_a{{8,8,0,0},{56,8,0,32}},source_b{{32,8,1,32}},destination;
        for(u64 b=0;b<64;++b) {
            const auto label=old[b];
            if(!destination.empty()&&destination.back().fill==label.root&&destination.back().root_offset+destination.back().size==label.offset)
                ++destination.back().size;
            else destination.push_back({b,1,label.root,label.offset});
        }
        if(mode==Conflict) source_b={{8,8,1,8}};
        if(mode==Ambiguous) source_b={{8,8,0,0}};
        std::array<S::ReconciliationReplica,3> replicas{{{0,{},source_a},{1,{},source_b},{2,{},destination}}};
        const auto remap=[&]{s->runtime.test_mapping.generation+=2;s->runtime.test_mapping.epoch->generation.store(s->runtime.test_mapping.generation);};
        if(mode==SourceStale) s->scheduler.RecordBufferFill(targets[0].pin.Handle(),8,4,0x4d4d4d4d);
        if(mode==ComplementStale) s->scheduler.RecordBufferFill(targets[2].pin.Handle(),24,4,0x4d4d4d4d);
        if(mode==Remap) remap();
        if(mode==PteMismatch) s->runtime.test_mapping.bias=4096;
        if(mode==Retired) owners[2]->RevokeContentEligibility();
        if(mode==MissingSync) s->scheduler.ForgetTransferSyncEvidenceForTest(anchor);
        if(mode==WrongQueue) s->scheduler.BreakReplicaQueueIdentityForTest(anchor);
        if(mode==UnknownProducer) s->scheduler.Record([](vk::CommandBuffer){});
        if(mode==WrongReceipt) replicas[2].receipt=anchor;
        const auto submissions=driver->submissions,recorded=driver->recorded.size(),queued=s->scheduler.commands.size();
        const auto plan=s->scheduler.PlanControlledReconciliation(s->runtime.test_mapping,
            {anchor,{targets[2].physical->Backing(),targets[2].physical->Segments().front().physical_offset,64},2,replicas});
        assert(driver->submissions==submissions && driver->recorded.size()==recorded && s->scheduler.commands.size()==queued); // Query never records or submits.
        const bool refused=(mode>=Conflict&&mode<=WrongReceipt)||mode==PteMismatch;
        if(refused) {
            const auto reason=mode==Conflict?Reason::ConflictingSources:mode==Ambiguous?Reason::AmbiguousSources:
                (mode==Remap||mode==PteMismatch)?Reason::Remapped:mode==Retired?Reason::Retired:mode==MissingSync?Reason::SynchronizationUnknown:
                mode==WrongQueue?Reason::CrossQueueUnknown:mode==Pending?Reason::SubmissionUnknown:
                mode==WrongReceipt?Reason::Ancestry:Reason::CurrentUnavailable;
            assert(plan.state==(mode==Conflict||mode==WrongReceipt?State::Refused:State::Unknown));
            assert(plan.reason==reason && !plan.content);
            (void)s->scheduler.Flush();s->scheduler.RunWorker();s->gpu.Complete();s->scheduler.RetireCheckedWritesAfterDeviceIdle();continue;
        }
        assert(plan.state==State::Candidate && plan.reason==Reason::None && plan.content);
        const auto metadata=plan.content;
        if(mode==LeaseSource) s->scheduler.RecordBufferFill(targets[0].pin.Handle(),8,4,0x4d4d4d4d);
        if(mode==LeaseComplement) s->scheduler.RecordBufferFill(targets[2].pin.Handle(),48,4,0x4d4d4d4d);
        if(mode==LeaseRemap) remap();
        if(mode==LeaseRetire) owners[2]->RevokeContentEligibility();
        if(mode==LeaseSync) s->scheduler.ForgetTransferSyncEvidenceForTest(anchor);
        if(mode==QueueIntervened) {(void)s->scheduler.FlushChecked();s->scheduler.RunWorker();s->gpu.Complete();}
        std::vector<S::ReplicaCopyRegion> commands;
        for(const auto& region:metadata->Regions()) commands.push_back({region.source,region.source_offset,region.destination_offset,region.size,{},region.roots});
        const auto result=s->scheduler.RecordControlledReplicaCopies(s->runtime.test_mapping,{anchor,2,8,56,commands,{},metadata->DestinationRoots()});
        const bool lease_rejected=mode>=LeaseSource&&mode<=LeaseSync;
        assert(bool(result)==!lease_rejected);
        if(lease_rejected) {(void)s->scheduler.Flush();s->scheduler.RunWorker();s->gpu.Complete();s->scheduler.RetireCheckedWritesAfterDeviceIdle();continue;}
        if(mode==PartialOne) driver->fail_copy_after=1;
        if(mode==PartialTwo) driver->fail_copy_after=2;
        if(mode==SubmitFailure||mode==UncertainSubmit) {driver->submit_result=VK_ERROR_DEVICE_LOST;driver->uncertain_submit_effects=mode==UncertainSubmit;}
        const auto prior_tick=driver->counter;
        bool loss{};try{s->scheduler.RunWorker();}catch(const vk::Exception&){loss=true;}
        assert(loss==(mode==SubmitFailure||mode==UncertainSubmit));s->gpu.Complete();
        if(mode==SubmitFailure||mode==UncertainSubmit) assert(driver->counter==prior_tick);
        if(mode==MissingOutputSync) s->scheduler.ForgetTransferSyncEvidenceForTest(result);
        const bool bad=mode==PartialOne||mode==PartialTwo||mode==SubmitFailure||mode==UncertainSubmit||mode==QueueIntervened||mode==MissingOutputSync;
        for(u64 b=0;b<64;++b) {
            const bool copied=(b>=8&&b<16)||(b>=32&&b<40)||b>=56;
            const auto label=copied?oracle[b>=32&&b<40?1:0][b]:old[b];
            assert(metadata->HasRoot(b,1,label.root,label.offset));
            assert(s->scheduler.CurrentReplicaCopyHasRoot(result,s->runtime.test_mapping,anchor,b,1,label.root,label.offset)==!bad);
            const bool no_write=mode==SubmitFailure||mode==QueueIntervened;
            const bool suffix=(mode==PartialOne&&(b>=32))||(mode==PartialTwo&&b>=56);
            assert(reinterpret_cast<Allocation*>(owners[2]->Handle())->bytes[b]==((no_write||suffix)?old[b].value:label.value));
            const bool uncertain=mode==SubmitFailure||mode==UncertainSubmit;
            assert(s->scheduler.CurrentTransferHasRoot(anchor,s->runtime.test_mapping,2,b,1,old[b].root,old[b].offset)==(!uncertain&&!copied));
        }
        if(mode==Good) {
            std::vector<R> current_target;
            for(u64 b=0;b<64;++b) {
                const bool copied=(b>=8&&b<16)||(b>=32&&b<40)||b>=56;
                const auto label=copied?oracle[b>=32&&b<40?1:0][b]:old[b];
                if(!current_target.empty()&&current_target.back().fill==label.root&&current_target.back().root_offset+current_target.back().size==label.offset)
                    ++current_target.back().size;
                else current_target.push_back({b,1,label.root,label.offset});
            }
            replicas[2]={2,result,current_target};
            const auto before=s->scheduler.commands.size();
            const auto second_plan=s->scheduler.PlanControlledReconciliation(s->runtime.test_mapping,
                {anchor,{targets[2].physical->Backing(),targets[2].physical->Segments().front().physical_offset,64},2,replicas});
            assert(second_plan.state==State::Candidate && second_plan.reason==Reason::None && second_plan.content->Depth()==2);
            assert(s->scheduler.commands.size()==before);
        }
        assert(plan.state==State::Candidate && plan.content==metadata); // Immutable recipe, not a mutable content/authority certificate.
        s->scheduler.RetireCheckedWritesAfterDeviceIdle();
    }
    std::cout<<"PASS 24 reconciliation query/admission modes: reasoned decisions, zero query GPU effects, no async lease, "
        "partial prefixes, unknown effects, preserved complements and actual-queue refusal; simulated Vulkan\n";
}
