struct Allocation { std::vector<u8> bytes; explicit Allocation(size_t size):bytes(size) {} };
struct Driver {
    std::function<void()> on_enqueue;
    VkResult submit_result=VK_SUCCESS,counter_result=VK_SUCCESS,wait_result=VK_SUCCESS,flush_result=VK_SUCCESS,invalidate_result=VK_SUCCESS;
    u64 counter=0,submitted_tick=0;
    size_t submissions=0,barriers=0,reported_losses=0;
    uintptr_t queue_id{1};
    bool corrupt=false;
    bool fail_allocation=false;
    bool fail_copy_record=false;
    size_t fail_copy_after{},copies_recorded{};
    bool uncertain_submit_effects=false;
    bool host_read_barrier=false;
    VkBuffer readback_target=VK_NULL_HANDLE;
    VkBuffer draw_target=VK_NULL_HANDLE;
    size_t draws{};
    std::vector<std::function<void()>> recorded,submitted;
    void Complete() {
        for(auto& command:submitted) {command();}
        submitted.clear();counter=submitted_tick;
    }
};
inline Driver* driver;
namespace vk {
class Exception:public std::exception {
    VkResult result;
public:
    explicit Exception(VkResult value=VK_ERROR_UNKNOWN):result{value} {}
    VkResult GetResult() const {return result;}
};
inline void Check(VkResult result) {if(result!=VK_SUCCESS) throw Exception{result};}
class Buffer {
    std::shared_ptr<Allocation> allocation;
public:
    Buffer()=default;
    explicit Buffer(size_t size):allocation{std::make_shared<Allocation>(size)} {}
    Buffer(const Buffer&)=delete;Buffer& operator=(const Buffer&)=delete;
    Buffer(Buffer&&)=default;Buffer& operator=(Buffer&&)=default;
    explicit operator bool() const {return bool(allocation);}
    VkBuffer operator*() const {return reinterpret_cast<VkBuffer>(allocation.get());}
    std::span<u8> Mapped() {return allocation?std::span<u8>{allocation->bytes}:std::span<u8>{};}
    std::span<const u8> Mapped() const {return allocation?std::span<const u8>{allocation->bytes}:std::span<const u8>{};}
    VkResult FlushChecked() const {return driver->flush_result;}
    VkResult InvalidateChecked() const {return driver->invalidate_result;}
    void reset() {allocation.reset();}
};
struct CommandBuffer {
    void FillBuffer(VkBuffer destination,u64 offset,u64 size,u32 value) {
        driver->recorded.push_back([=] {
            auto& bytes=reinterpret_cast<Allocation*>(destination)->bytes;
            for(u64 i=0;i<size;++i) bytes[offset+i]=static_cast<u8>(value >> (8*(i%4)));
        });
    }
    template<class... T> void Draw(T...) {++driver->draws;FillBuffer(driver->draw_target,0,4096,0x63636363);}
    template<class... T> void DrawIndexed(T... args) {Draw(args...);}
    template<class... T> void DrawIndirectByteCountEXT(T... args) {Draw(args...);}
    template<class... T> void DrawIndexedIndirectCount(T... args) {Draw(args...);}
    template<class... T> void DrawIndirectCount(T... args) {Draw(args...);}
    template<class... T> void DrawIndexedIndirect(T... args) {Draw(args...);}
    template<class... T> void DrawIndirect(T... args) {Draw(args...);}
    template<class... T> void Dispatch(T... args) {Draw(args...);}
    template<class... T> void DispatchIndirect(T... args) {Draw(args...);}
    void Begin(...) {} void End() {}
    VkCommandBuffer operator*() const {return reinterpret_cast<VkCommandBuffer>(uintptr_t{1});}
    void PipelineBarrier(VkPipelineStageFlags,VkPipelineStageFlags dst,u32,const VkMemoryBarrier& barrier) {
        ++driver->barriers;
        if((dst&VK_PIPELINE_STAGE_HOST_BIT) && (barrier.dstAccessMask&VK_ACCESS_HOST_READ_BIT))
            driver->host_read_barrier=true;
    }
    template<class Copies> void CopyBuffer(VkBuffer source,VkBuffer destination,const Copies& copies) {
        for(const auto& copy:copies) {
            driver->recorded.push_back([=] {
                auto& src=reinterpret_cast<Allocation*>(source)->bytes;
                auto& dst=reinterpret_cast<Allocation*>(destination)->bytes;
                std::memcpy(dst.data()+copy.dstOffset,src.data()+copy.srcOffset,copy.size);
                if(driver->corrupt && destination==driver->readback_target) dst[copy.dstOffset+7]^=1;
            });
            if(driver->fail_copy_record || (driver->fail_copy_after && ++driver->copies_recorded == driver->fail_copy_after)) throw std::runtime_error("partial copy recording failure");
        }
    }
};
