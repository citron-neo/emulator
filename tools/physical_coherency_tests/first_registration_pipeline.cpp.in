class RasterizerVulkan {
public:
    using BufferCache=::Cache;
    using ControlledCpuWritePtr=Cache::ControlledCpuWritePtr;
    using ControlledRegistrationPtr=Cache::ControlledRegistrationPtr;
    Cache& buffer_cache;
    struct GpuFacade {
        VideoCommon::GPUThread::ThreadManager* manager{};
        bool TryQueueCpuWrite(std::function<bool()> poll);
    } gpu;
    bool QueueControlledCpuWriteRequest(const Cache::ControlledRegistrationPtr&,
        const Core::Memory::ControlledCpuWriteRequestPtr&);
    Core::Memory::ControlledCpuWriteRequest::Phase AdvanceControlledCpuWriteRequest(
        const ControlledCpuWritePtr&);
};
// @REQUEST_ADVANCE@
}
// @GPU_THREAD@
bool Vulkan::RasterizerVulkan::GpuFacade::TryQueueCpuWrite(std::function<bool()> poll) {
    return manager && manager->TryQueueCpuWrite(std::move(poll));
}
namespace Vulkan {
// @REQUEST_QUEUE@
}
struct Scenario {
    Driver gpu;
    Vulkan::Device device;
    Vulkan::Scheduler scheduler{device};
    Vulkan::BufferCacheRuntime runtime{device,scheduler};
    System system;Common::PageTable table;Cpu cpu{system,&table};
    std::unique_ptr<Cache> cache;
    std::vector<Core::Memory::PreparedCpuPage> views;
    Scenario() {
        driver=&gpu;table.Resize(20,12);
        cpu.MapPages(table,1,16,B,Common::PageType::Memory);
        cpu.MapPages(table,32,16,B,Common::PageType::Memory);
        std::memset(system.device.buffer.BackingBasePointer(),10,2*C);
        for(u64 i=0;i<16;++i) {auto view=cpu.PrepareControlledCpuPage(4096+i*4096);assert(view);views.push_back(*view);}
        cache=std::make_unique<Cache>(cpu,runtime);
    }
    ~Scenario() {
        scheduler.RunWorker();gpu.Complete(); // Fixture checked idle, after the producer stopped.
        runtime.staged_pin_domain->Seal();runtime.RetireControlledTransfersAfterDeviceIdle();
    }
    u8 backing(u64 off) const {return system.device.buffer.BackingBasePointer()[off];}
    u8 cached(const Cache::ControlledRegistrationPtr& op,u64 off) {
        const auto id=cache->ControlledReadyBuffer(op);assert(id && id!=NULL_BUFFER_ID);
        const auto pin=cache->slot_buffers[id].PinStagedRepresentation(0,C);assert(pin);
        return reinterpret_cast<Allocation*>(pin->Handle())->bytes[off];
    }
    void finish(const Cache::ControlledRegistrationPtr& op) {
        assert(cache->PollControlledRegistration(op)==Phase::Submitted);
        assert(cache->ControlledReadyBuffer(op)==NULL_BUFFER_ID && !op->BeginCachedWrite());
        scheduler.RunWorker();
        if(!gpu.host_read_barrier) {std::cerr<<"missing explicit host visibility barrier\n";std::exit(84);}
        if(cache->PollControlledRegistration(op)!=Phase::Submitted) {
            std::cerr<<"callback/submit return mistaken for completed readback\n";std::exit(82);
        }
        gpu.Complete();assert(cache->PollControlledRegistration(op)==Phase::Ready);
    }
};
void writer_first(size_t index) {
    auto s=std::make_unique<Scenario>();const u64 off=index*4096+7;
    auto alias=s->cpu.PrepareControlledCpuPage(32*4096+index*4096);assert(alias);
    std::latch entered{1},release{1};Result result=Result::Invalid;
    before_cpu_store=[&]{entered.count_down();release.wait();};
    std::thread writer([&]{result=s->cpu.Write<u8>(*alias,32*4096+off,77);});entered.wait();
    auto op=s->cache->BeginControlledFirstRegistration(A+off,1,s->views);assert(op);
    assert(s->cache->PollControlledRegistration(op)==Phase::Waiting);
    assert(s->cache->device_tracker.markings==0 && !s->cache->IsRegionRegistered(A,C));
    std::thread independent([&]{release.count_down();});writer.join();independent.join();before_cpu_store={};
    assert(result==Result::Stored && s->backing(off)==77);
    assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);
    s->finish(op);
    assert(s->cached(op,off)==77 && !s->cache->memory_tracker.IsRegionCpuModified(A,C));
    assert(s->gpu.submissions==1 && s->gpu.barriers>=4);
}
void registration_first() {
    auto s=std::make_unique<Scenario>();constexpr u64 off=15*4096+7;
    auto op=s->cache->BeginControlledFirstRegistration(A+off,1,s->views);assert(op);
    assert(s->cpu.Write<u8>(s->views.back(),4096+off,77)==Result::NeedSlow && s->backing(off)==10);
    assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
    // Model a previously tracked device alias whose old cache has been removed. Its initially
    // clean real tracker must still receive the physical write's post-store publication.
    s->cache->memory_tracker.ForEachUploadRange(ALIAS,C,[](u64,u64) {});
    auto view=s->cpu.PrepareControlledCpuPage(32*4096+15*4096);assert(view);
    auto write=op->BeginCachedWrite();assert(write);
    assert(write->TryStart()==Common::PhysicalRangeAdmission::Start::Granted);
    assert(s->cache->CommitControlledCachedWrite(op,*view,*write,32*4096+off,1,[&] {
        return s->cpu.WriteCached<u8>(*view,*write,32*4096+off,77);
    })==Result::Stored);
    if(s->backing(off)!=77 || !s->cache->memory_tracker.IsRegionCpuModified(A+off,1) ||
       !s->cache->memory_tracker.IsRegionCpuModified(ALIAS+off,1)) {
        std::cerr<<"cached continuation missed a real tracker alias\n";std::exit(83);
    }
    assert(s->cache->ControlledReadyBuffer(op)==NULL_BUFFER_ID); // No protected read of stale 10.
    assert(write->CompleteAfterTrackerPublication());
    assert(s->cache->BeginControlledRefresh(op));
    assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
    assert(s->cached(op,off)==77 && !s->cache->memory_tracker.IsRegionCpuModified(A,C));
    assert(s->gpu.submissions==2);
}
void production_write_transaction(u64 width,bool deferred=false) {
    auto s=std::make_unique<Scenario>();constexpr u64 off=4096+7;
    auto op=s->cache->BeginControlledFirstRegistration(A+off,1,s->views);assert(op);
    assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
    // The fixture driver executes GPU work in submission order; CPU backing still holds 10.
    const auto id=s->cache->ControlledReadyBuffer(op);
    auto pin=s->cache->slot_buffers[id].PinStagedRepresentation(0,C);assert(pin);
    auto& native=reinterpret_cast<Allocation*>(pin->Handle())->bytes;
    s->gpu.recorded.push_back([&native] {std::fill(native.begin(),native.end(),99);});
    auto gpu_write=s->scheduler.FlushChecked();s->scheduler.RunWorker();s->gpu.Complete();
    assert(s->scheduler.PollChecked(gpu_write)==VK_SUCCESS);
    s->cache->memory_tracker.MarkRegionAsGpuModified(A,C);
    s->cache->memory_tracker.ForEachUploadRange(ALIAS,C,[](u64,u64) {});
    auto view=s->cpu.PrepareControlledCpuPage(4096+4096);assert(view);
    Core::Memory::Memory memory{&s->cpu};Vulkan::RasterizerVulkan rasterizer{*s->cache};
    Core::Memory::ControlledCpuWriteRequestPtr request;
    using Request=Core::Memory::ControlledCpuWriteRequest;
    u64 source=0x4d4d4d4d4d4d4d4d;
    if(deferred) {
        std::thread cpu_producer([&] {
            assert(!Core::Memory::ScopedCpuWrite::Current());
            switch(width) {
            case 1: request=memory.PrepareControlledWrite8(4096+off,u8(source));break;
            case 2: request=memory.PrepareControlledWrite16(4096+off,u16(source));break;
            case 4: request=memory.PrepareControlledWrite32(4096+off,u32(source));break;
            case 8: request=memory.PrepareControlledWrite64(4096+off,source);break;
            }
        });cpu_producer.join();
        assert(request && request->State()==Request::Phase::Prepared && !request->Outcome());
        source=0; // No borrowed scalar survives CPU preparation.
    }
    auto tx=deferred?s->cache->BeginControlledCpuWriteRequest(op,request):
        s->cache->BeginControlledCpuWrite(op,*view,4096+off,width);assert(tx);
    const auto require_pending=[&] {
        if(request && (request->State()!=Request::Phase::Accepted || request->Outcome())) {
            std::cerr<<"request completed before actual store publication\n";std::exit(89);
        }
    };
    require_pending();
    using Tx=Cache::ControlledCpuWrite::Phase;
    assert(s->cache->PollControlledCpuWrite(tx)==Tx::Submitted);
    assert(s->cache->PollControlledRegistration(op)==Phase::Writing);
    assert(!op->BeginCachedWrite() && !s->cache->BeginControlledRefresh(op));
    assert(s->cache->ControlledReadyBuffer(op)==NULL_BUFFER_ID);
    const auto expect_upload_blocked=[&] {
        bool blocked=false;
        try {s->cache->SynchronizeBuffer(s->cache->slot_buffers[id],A,C);}
        catch(const std::runtime_error&) {blocked=true;}
        if(!blocked) {std::cerr<<"upload consumed publication inside write transaction\n";std::exit(86);}
        blocked=false;
        try {s->cache->SynchronizeBuffer(s->cache->slot_buffers[id],ALIAS,C);}
        catch(const std::runtime_error&) {blocked=true;}
        assert(blocked);
    };
    expect_upload_blocked();
    s->scheduler.RunWorker();
    if(request) assert(rasterizer.AdvanceControlledCpuWriteRequest(tx)==Request::Phase::Accepted);
    require_pending();
    assert(s->cache->PollControlledCpuWrite(tx)==Tx::Submitted);
    assert(s->backing(off)==10 && s->cache->memory_tracker.IsRegionGpuModified(A,C));
    s->gpu.Complete();
    assert(s->cache->PollControlledCpuWrite(tx)==Tx::Preserved);
    require_pending();
    const auto domain=view->physical.Epoch()->ranges;
    const std::array access{Common::PhysicalRangeAdmission::Access{4096,4096,Common::PhysicalRangeAdmission::Mode::Read}};
    auto reader=domain->Enqueue(access,std::make_shared<int>(1));assert(reader);
    assert(domain->TryStart(reader)==Common::PhysicalRangeAdmission::Start::Park);
    assert(s->cache->CommitControlledCpuTransaction(tx,width==1?2:1,[&](const auto&,auto&,u64) {
        assert(false);return Result::Stored;
    })==Result::Invalid);
    bool stored=false;
    if(request) {
        assert(!request->Cancel() && !s->cache->BeginControlledCpuWriteRequest(op,request));
        assert(s->cache->CommitControlledCpuTransaction(tx,width,[&](const auto&,auto&,u64) {
            assert(false);return Result::Stored;
        })==Result::Invalid);
        before_cpu_store=[&] {require_pending();expect_upload_blocked();};
        s->cache->device_tracker.before_mark=[&] {
            require_pending();expect_upload_blocked();assert(s->backing(off)==77);
            assert(domain->TryStart(reader)==Common::PhysicalRangeAdmission::Start::Park);
        };
        bool observed=false;
        std::thread cpu_consumer([&] {
            while(request->State()==Request::Phase::Accepted) std::this_thread::yield();
            observed=request->State()==Request::Phase::Stored && request->Outcome()==Result::Stored && s->backing(off)==77;
        });
        assert(rasterizer.AdvanceControlledCpuWriteRequest(tx)==Request::Phase::Stored);
        cpu_consumer.join();assert(observed);
        before_cpu_store={};s->cache->device_tracker.before_mark=[] {};
        stored=true;
    } else assert(s->cache->CommitControlledCpuTransaction(tx,width,[&](const auto& target,auto& write,u64 address) {
        expect_upload_blocked();
        Result result=Result::Invalid;
        switch(width) {
        case 1: result=memory.WriteOrdinaryControlled8(target,write,address,77);break;
        case 2: result=memory.WriteOrdinaryControlled16(target,write,address,0x4d4d);break;
        case 4: result=memory.WriteOrdinaryControlled32(target,write,address,0x4d4d4d4d);break;
        case 8: result=memory.WriteOrdinaryControlled64(target,write,address,0x4d4d4d4d4d4d4d4d);break;
        }
        stored=result==Result::Stored;
        assert(!Core::Memory::ScopedCpuWrite::Current());
        assert(s->cpu.legacy_pointer_lookups==0 && s->cpu.legacy_callbacks==0);
        assert(s->cache->memory_tracker.IsRegionGpuModified(A,C));
        expect_upload_blocked(); // Actual store happened, real tracker publication has not.
        assert(domain->TryStart(reader)==Common::PhysicalRangeAdmission::Start::Park);
        return result;
    })==Result::Stored && stored);
    assert(stored && !Core::Memory::ScopedCpuWrite::Current());
    bool store_exact=true;
    for(u64 i=0;i<width;++i) store_exact &= s->backing(off+i)==77;
    if(s->backing(off-1)!=99 || !store_exact || s->backing(off+width)!=99) {
        std::cerr<<"GPU dirty complement lost before CPU store\n";std::exit(85);
    }
    assert(tx->State()==Tx::Committed);
    const auto publication=view->physical.Published();assert(publication);
    for(u64 i=0;i<4096;++i) assert(publication->Contains(i)==(i>=7 && i<7+width));
    assert(!s->cache->memory_tracker.IsRegionGpuModified(A,C));
    if(!s->cache->memory_tracker.IsRegionCpuModified(A+off,1) ||
       !s->cache->memory_tracker.IsRegionCpuModified(ALIAS+off,1)) {
        std::cerr<<"transaction omitted real tracker publication\n";std::exit(87);
    }
    assert(domain->TryStart(reader)==Common::PhysicalRangeAdmission::Start::Granted);
    assert(domain->Complete(reader));
    assert(s->cache->BeginControlledRefresh(op));
    assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
    assert(s->cached(op,off-1)==99 && s->cached(op,off)==77 && s->cached(op,off+width)==99);
    assert(!s->cache->memory_tracker.IsRegionCpuModified(A,C));
}

void request_lifecycle() {
    using Request=Core::Memory::ControlledCpuWriteRequest;
    for(int mode=0;mode<6;++mode) {
        auto s=std::make_unique<Scenario>();Core::Memory::Memory memory{&s->cpu};
        assert(!memory.PrepareControlledWrite8(4103,77)); // Uncached target cannot qualify.
        auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
        assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
        assert(!memory.PrepareControlledWrite16(8191,77));
        auto request=memory.PrepareControlledWrite8(4103,77);assert(request);
        if(mode==0) {
            assert(request->Cancel() && !request->Cancel());
            assert(!s->cache->BeginControlledCpuWriteRequest(op,request));
            assert(request->State()==Request::Phase::Cancelled && !request->Outcome());
            assert(request->Action()==Request::SchedulerAction::DoNotExecute);
            assert(op->State()==Phase::Ready && s->backing(7)==10);continue;
        }
        if(mode==1) {
            s->cpu.MapPages(s->table,1,1,B,Common::PageType::RasterizerCachedMemory);
            assert(!s->cache->BeginControlledCpuWriteRequest(op,request));
            assert(request->State()==Request::Phase::Refused && request->Outcome()==Result::NeedSlow);
            assert(request->Action()==Request::SchedulerAction::ReprepareCertified);
            assert(s->gpu.submissions==1 && s->backing(7)==10);continue;
        }
        if(mode==5) {
            s->gpu.fail_allocation=true;
            bool failed=false;
            try {(void)s->cache->BeginControlledCpuWriteRequest(op,request);}
            catch(const std::bad_alloc&) {failed=true;}
            s->gpu.fail_allocation=false;assert(failed);
            assert(request->State()==Request::Phase::Unknown);
            memory.SealControlledCpuWrites();
            std::weak_ptr<Request> retained=request;request.reset();
            if(retained.expired()) {
                std::cerr<<"accepted construction failure lost request identity\n";std::exit(94);
            }
            continue;
        }
        if(mode==4) {
            const auto domain=request->View().physical.Epoch()->ranges;
            const std::array access{Common::PhysicalRangeAdmission::Access{
                0,4096,Common::PhysicalRangeAdmission::Mode::Write}};
            auto predecessor=domain->Enqueue(access,std::make_shared<int>(1));assert(predecessor);
            assert(domain->TryStart(predecessor)==Common::PhysicalRangeAdmission::Start::Granted);
            auto tx=s->cache->BeginControlledCpuWriteRequest(op,request);assert(tx);
            assert(s->cache->PollControlledCpuWrite(tx)==Cache::ControlledCpuWrite::Phase::Waiting);
            memory.SealControlledCpuWrites();
            assert(s->cache->PollControlledCpuWrite(tx)==Cache::ControlledCpuWrite::Phase::Unknown);
            assert(domain->Complete(predecessor));
            std::weak_ptr<ControlledBufferTransfer> native=s->runtime.controlled_transfers.back();
            std::weak_ptr<Request> retained=request;request.reset();tx.reset();
            if(retained.expired() || native.expired()) {
                std::cerr<<"accepted parked Unknown lost its execution identity\n";std::exit(93);
            }
            continue;
        }
        s->cache->memory_tracker.MarkRegionAsGpuModified(A,C);
        auto tx=s->cache->BeginControlledCpuWriteRequest(op,request);assert(tx);
        assert(!request->Cancel());
        assert(s->cache->PollControlledCpuWrite(tx)==Cache::ControlledCpuWrite::Phase::Submitted);
        if(mode==2) s->gpu.submit_result=VK_ERROR_DEVICE_LOST;
        s->scheduler.RunWorker();s->gpu.Complete();
        Vulkan::RasterizerVulkan rasterizer{*s->cache};
        if(mode==3) memory.SealControlledCpuWrites();
        const auto completion=rasterizer.AdvanceControlledCpuWriteRequest(tx);
        if(mode==3 && completion!=Request::Phase::Unknown) {
            std::cerr<<"closed Memory owner executed a queued CPU store\n";std::exit(92);
        }
        assert(completion==Request::Phase::Unknown);
        assert(!request->Outcome() && s->backing(7)==10 && s->cache->memory_tracker.IsRegionGpuModified(A,C));
        std::weak_ptr<Request> retained=request;
        request.reset();tx.reset();
        if(retained.expired()) {
            std::cerr<<"accepted request owner escaped Unknown retention\n";std::exit(90);
        }
    }
    // The CPU's cancellation CAS and GPU-owner acceptance CAS choose one owner of the store.
    for(int i=0;i<8;++i) {
        auto s=std::make_unique<Scenario>();Core::Memory::Memory memory{&s->cpu};
        auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
        assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
        auto request=memory.PrepareControlledWrite8(4103,77);assert(request);
        bool cancelled=false;std::thread cpu([&]{cancelled=request->Cancel();});
        auto tx=s->cache->BeginControlledCpuWriteRequest(op,request);cpu.join();
        if(cancelled) {
            assert(!tx && request->State()==Request::Phase::Cancelled && s->backing(7)==10);
        } else {
            assert(tx && request->State()==Request::Phase::Accepted);
            Vulkan::RasterizerVulkan rasterizer{*s->cache};
            assert(rasterizer.AdvanceControlledCpuWriteRequest(tx)==Request::Phase::Accepted);
            s->scheduler.RunWorker();s->gpu.Complete();
            assert(rasterizer.AdvanceControlledCpuWriteRequest(tx)==Request::Phase::Stored);
            assert(request->Outcome()==Result::Stored && s->backing(7)==77);
        }
    }
}

void scheduler_handoff() {
    using Request=Core::Memory::ControlledCpuWriteRequest;
    for(bool close_owner: {false,true}) {
        auto s=std::make_unique<Scenario>();Core::Memory::Memory memory{&s->cpu};
        auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
        assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
        auto id=s->cache->ControlledReadyBuffer(op);
        auto pin=s->cache->slot_buffers[id].PinStagedRepresentation(0,C);assert(pin);
        auto& bytes=reinterpret_cast<Allocation*>(pin->Handle())->bytes;
        std::fill(bytes.begin(),bytes.end(),99); // Fixture GPU allocation contents, not hardware evidence.
        s->cache->memory_tracker.MarkRegionAsGpuModified(A,C);
        auto request=memory.PrepareControlledWrite8(4103,77);assert(request);
        const auto admission=request->View().physical.Epoch()->ranges;
        const std::array access{Common::PhysicalRangeAdmission::Access{0,4096,Common::PhysicalRangeAdmission::Mode::Write}};
        auto predecessor=admission->Enqueue(access,std::make_shared<int>(1));assert(predecessor);
        assert(admission->TryStart(predecessor)==Common::PhysicalRangeAdmission::Start::Granted);
        Core::System owner_system;VideoCore::RendererBase renderer;
        Core::Frontend::GraphicsContext context;Tegra::Control::Scheduler channels;
        VideoCommon::GPUThread::ThreadManager manager{owner_system,true};
        Vulkan::RasterizerVulkan rasterizer{*s->cache};rasterizer.gpu.manager=&manager;
        manager.StartThread(renderer,context,channels);
        Event entered,release;
        std::mutex sys_core_guard;
        auto blocked=std::async(std::launch::async,[&] {
            manager.RunOnGpuThread([&] {entered.Set();release.Wait();});
        });entered.Wait();
        Event cpu_suspended,cpu_resume;
        std::thread cpu_producer([&] {
            {std::scoped_lock sys_lock{sys_core_guard},cache_lock{s->cache->mutex};
             std::shared_lock pte_lock{request->View().mapping.domain->mutex};
             assert(rasterizer.QueueControlledCpuWriteRequest(op,request));
             assert(request->State()==Request::Phase::Prepared);}
            cpu_suspended.Set();cpu_resume.Wait(); // no producer lock survives suspension
        });cpu_suspended.Wait();
        // The producer can release its real PTE/cache guards before releasing the GPU worker.
        release.Set();Ready(blocked);
        const auto guards_released=[&] {
            std::unique_lock cache_lock{s->cache->mutex,std::try_to_lock};
            std::unique_lock pte_lock{request->View().mapping.domain->mutex,std::try_to_lock};
            std::unique_lock sys_lock{sys_core_guard,std::try_to_lock};
            assert(cache_lock.owns_lock() && pte_lock.owns_lock() && sys_lock.owns_lock());
        };
        manager.RunOnGpuThread([&] {guards_released();assert(admission->Complete(predecessor));});
        manager.RunOnGpuThread([&] {guards_released();s->scheduler.RunWorker();});
        assert(request->State()==Request::Phase::Accepted && !request->Outcome());
        if(close_owner) memory.SealControlledCpuWrites(); // Actual gate used before KProcess PTE finalization.
        manager.RunOnGpuThread([&] {s->gpu.Complete();});manager.Synchronize();
        if(close_owner) {
            if(request->State()!=Request::Phase::Unknown || s->backing(7)==77) {
                std::cerr<<"closed Memory owner executed a queued CPU store\n";std::exit(92);
            }
            assert(request->Action()==Request::SchedulerAction::Quarantine);
            assert(s->cache->memory_tracker.IsRegionGpuModified(A,C));
            s->cache->device_memory.epoch->generation.fetch_add(2);
            s->cache->CheckControlledSynchronization(5*C,4); // Unrelated current range still runs after remap.
            bool isolated=false;
            try {s->cache->CheckControlledSynchronization(A,4);} catch(const std::runtime_error&) {isolated=true;}
            assert(isolated);
        } else {
            assert(request->State()==Request::Phase::Stored && request->Outcome()==Result::Stored);
            assert(s->backing(6)==99 && s->backing(7)==77 && s->backing(8)==99);
            assert(request->View().physical.Published()->sequence==1);
            memory.SealControlledCpuWrites();
            assert(request->State()==Request::Phase::Stored && request->Outcome()==Result::Stored);
            assert(!rasterizer.QueueControlledCpuWriteRequest(op,request));
            for(int i=0;i<8;++i) {manager.TickGPU();}
            manager.Synchronize();
            assert(request->View().physical.Published()->sequence==1);
        }
        const int before=owner_system.gpu.ticks;
        for(int i=0;i<8;++i) {manager.TickGPU();}
        manager.Synchronize();assert(owner_system.gpu.ticks==before+8);
        cpu_resume.Set();cpu_producer.join();
        manager.Stop();
    }
}

void enqueue_close_and_teardown() {
    using Request=Core::Memory::ControlledCpuWriteRequest;
    for(int i=0;i<8;++i) {
        auto s=std::make_unique<Scenario>();auto memory=std::make_unique<Core::Memory::Memory>(&s->cpu);
        auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
        assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
        auto request=memory->PrepareControlledWrite8(4103,77);assert(request);
        Core::System owner_system;VideoCore::RendererBase renderer;
        Core::Frontend::GraphicsContext context;Tegra::Control::Scheduler channels;
        VideoCommon::GPUThread::ThreadManager manager{owner_system,true};
        Vulkan::RasterizerVulkan rasterizer{*s->cache};rasterizer.gpu.manager=&manager;
        manager.StartThread(renderer,context,channels);
        std::latch start{1};
        std::thread enqueue([&] {start.wait();(void)rasterizer.QueueControlledCpuWriteRequest(op,request);});
        std::thread close([&] {start.wait();memory->SealControlledCpuWrites();});
        start.count_down();enqueue.join();close.join();memory.reset();
        manager.RunOnGpuThread([&] {s->scheduler.RunWorker();s->gpu.Complete();});manager.Synchronize();
        assert(request->State()==Request::Phase::Cancelled || request->State()==Request::Phase::Unknown || request->State()==Request::Phase::Refused);
        assert(s->backing(7)==10);
        assert(!request->Outcome().has_value() || request->State()==Request::Phase::Refused);
        assert(!request->Owner()->TryVisit([](auto&) {assert(false);}));
        manager.Stop();
    }
    // Teardown closes only this Memory's entered execution visit, not a GPU queue drain.
    auto s=std::make_unique<Scenario>();Core::Memory::Memory memory{&s->cpu};
    auto owner=memory.controlled_owner;
    Event entered,release;
    auto executor=std::async(std::launch::async,[&] {
        return owner->TryVisit([&](auto&) {entered.Set();release.Wait();});
    });entered.Wait();
    std::atomic<bool> page_table_destroyed=false;
    auto teardown=std::async(std::launch::async,[&] {
        memory.SealControlledCpuWrites();s->table.Resize(16,12);page_table_destroyed=true;
    });
    assert(teardown.wait_for(std::chrono::milliseconds(20))!=std::future_status::ready && !page_table_destroyed);
    release.Set();assert(Ready(executor));Ready(teardown);
    assert(page_table_destroyed && !owner->TryVisit([](auto&) {assert(false);}));
}

void ordinary_binding_refusals() {
    using Binding=Core::Memory::ScopedCpuWrite;
    auto s=std::make_unique<Scenario>();
    auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
    assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
    auto view=s->cpu.PrepareControlledCpuPage(4096);assert(view);
    auto write=op->BeginCachedWrite();assert(write);
    assert(write->TryStart()==Common::PhysicalRangeAdmission::Start::Granted);
    Core::Memory::Memory memory{&s->cpu};
    const auto attempt=[&](auto action) {
        Binding binding{*view,*write,s->cpu.controlled_context.state.get(),4103,u8{77}};
        action();return binding.Outcome();
    };
    assert(attempt([&]{memory.Write8(4104,77);})==Result::Invalid);
    assert(attempt([&]{memory.Write16(4103,77);})==Result::Invalid);
    assert(attempt([&]{memory.Write8(4103,78);})==Result::Invalid);
    assert(attempt([&]{s->cpu.Write<u128>(4103,u128{});})==Result::Invalid);
    Cpu other{s->system,&s->table};Core::Memory::Memory wrong_memory{&other};
    assert(attempt([&]{wrong_memory.Write8(4103,77);})==Result::Invalid);
    assert(other.legacy_pointer_lookups==0 && s->backing(7)==10 && s->backing(8)==10);
    {const auto mutation=s->table.MutateMappings();
     assert(attempt([&]{memory.Write8(4103,77);})==Result::Busy);}
    assert(attempt([&]{memory.Write8(4103,77);})==Result::Stale);
    auto current=s->cpu.PrepareControlledCpuPage(4096);assert(current);
    assert(memory.WriteOrdinaryControlled16(*current,*write,8191,0x4d4d)==Result::Invalid);
    {Binding outer{*current,*write,s->cpu.controlled_context.state.get(),4103,u8{77}};
     {Binding inner{*current,*write,s->cpu.controlled_context.state.get(),4103,u8{77}};
      memory.Write8(4103,77);assert(inner.Outcome()==Result::Busy && s->backing(7)==10);}
     assert(Binding::Current()==&outer);
     std::thread independent([] {assert(!Binding::Current());});independent.join();
     memory.Write8(Common::ProcessAddress{0xabcd000000001007ULL},77);
     assert(outer.Outcome()==Result::Stored && s->backing(7)==77);
     memory.Write8(4103,77);assert(outer.Outcome()==Result::Invalid);}
    assert(!Binding::Current() && s->cpu.legacy_pointer_lookups==0 && s->cpu.legacy_callbacks==0);
    s->cache->memory_tracker.MarkRegionAsCpuModified(A+7,1);
    s->cache->memory_tracker.MarkRegionAsCpuModified(ALIAS+7,1);
    assert(write->CompleteAfterTrackerPublication());
}

void transaction_faults() {
    using Tx=Cache::ControlledCpuWrite::Phase;
    for(int fault=0;fault<6;++fault) {
        auto s=std::make_unique<Scenario>();
        auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
        assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
        s->cache->memory_tracker.MarkRegionAsGpuModified(A,C);
        auto view=s->cpu.PrepareControlledCpuPage(4096);assert(view);
        auto tx=s->cache->BeginControlledCpuWrite(op,*view,4103,1);assert(tx);
        assert(s->cache->PollControlledCpuWrite(tx)==Tx::Submitted);
        if(fault==0) s->gpu.submit_result=VK_ERROR_DEVICE_LOST;
        s->scheduler.RunWorker();s->gpu.Complete();
        if(fault==1) s->gpu.counter_result=VK_ERROR_DEVICE_LOST;
        if(fault==2) s->gpu.invalidate_result=VK_ERROR_MEMORY_MAP_FAILED;
        if(fault==3) ++s->cache->device_memory.epoch->generation;
        if(fault==4) s->cache->ReuseHidden(op);
        if(fault<5) {
            assert(s->cache->PollControlledCpuWrite(tx)==Tx::Unknown);
            assert(s->backing(7)==10 && s->cache->memory_tracker.IsRegionGpuModified(A,C));
        } else {
            assert(s->cache->PollControlledCpuWrite(tx)==Tx::Preserved);
            assert(s->cache->memory_tracker.IsRegionGpuModified(A,C));
            bool caught=false;
            try { (void)s->cache->CommitControlledCpuTransaction(tx,1,[&](const auto& target,auto& write,u64 address)->Result {
                Core::Memory::Memory memory{&s->cpu};
                assert(memory.WriteOrdinaryControlled8(target,write,address,77)==Result::Stored);
                throw std::runtime_error("store effected, publication interrupted");
            }); } catch(const std::runtime_error&) {caught=true;}
            assert(caught && tx->State()==Tx::Unknown && s->backing(7)==77);
            assert(s->cache->memory_tracker.IsRegionGpuModified(A,C));
        }
        assert(op->State()==Phase::Unknown && s->cache->ControlledReadyBuffer(op)==NULL_BUFFER_ID);
        const auto domain=view->physical.Epoch()->ranges;
        const std::array access{Common::PhysicalRangeAdmission::Access{0,4096,Common::PhysicalRangeAdmission::Mode::Read}};
        auto reader=domain->Enqueue(access,std::make_shared<int>(1));assert(reader);
        tx.reset(); // Uncertain native/physical owners remain retained by the admission request.
        assert(domain->TryStart(reader)==Common::PhysicalRangeAdmission::Start::Park);
        assert(domain->Cancel(reader));
    }
    {auto s=std::make_unique<Scenario>();
     auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
     assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
     auto view=s->cpu.PrepareControlledCpuPage(4096);assert(view);
     s->cache->ReuseHidden(op);
     assert(!s->cache->BeginControlledCpuWrite(op,*view,4103,1));
     assert(!s->cache->BeginControlledRefresh(op));
     assert(s->cache->PollControlledRegistration(op)==Phase::Cancelled);}
    {auto s=std::make_unique<Scenario>();
     auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
     assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
     s->cache->memory_tracker.MarkRegionAsGpuModified(A,C);
     auto view=s->cpu.PrepareControlledCpuPage(4096);assert(view);
     auto tx=s->cache->BeginControlledCpuWrite(op,*view,4103,1);assert(tx);
     assert(s->cache->PollControlledCpuWrite(tx)==Tx::Submitted);
     tx.reset();
     assert(op->State()==Phase::Unknown);
     assert(s->cache->memory_tracker.IsRegionGpuModified(A,C));
     assert(!s->runtime.controlled_transfers.back().expired());}
}

void faults() {
    {auto s=std::make_unique<Scenario>();s->device.timeline=false;
     assert(!s->cache->BeginControlledFirstRegistration(A,1,s->views));
     assert(s->gpu.submissions==0 && s->cache->device_tracker.markings==0);}
    {auto s=std::make_unique<Scenario>();s->gpu.flush_result=VK_ERROR_MEMORY_MAP_FAILED;
     auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
     assert(s->cache->PollControlledRegistration(op)==Phase::Unknown);
     assert(!s->cache->IsRegionRegistered(A,C) && s->gpu.submissions==0);}
    {auto s=std::make_unique<Scenario>();bool once=false;
     s->cache->device_memory.on_pin=[&] {if(!once) {once=true;++s->cache->device_memory.epoch->generation;}};
     assert(!s->cache->BeginControlledFirstRegistration(A,1,s->views));
     assert(s->cache->device_tracker.markings==0 && s->gpu.submissions==0);
     assert(s->cpu.Write<u8>(s->views.front(),4103,77)==Result::Stored);}
    // Remap before acceptance cancels without protection/upload effects.
    {auto s=std::make_unique<Scenario>();auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
     ++s->cache->device_memory.epoch->generation;
     assert(s->cache->PollControlledRegistration(op)==Phase::Cancelled);
     assert(s->cache->device_tracker.markings==0 && s->gpu.submissions==0);}
    {auto s=std::make_unique<Scenario>();
     s->cache->memory_tracker.ForEachUploadRange(ALIAS,C,[](u64,u64) {});
     s->cache->memory_tracker.MarkRegionAsGpuModified(ALIAS,4096);
     s->views.clear();
     for(u64 i=0;i<16;++i) {auto view=s->cpu.PrepareControlledCpuPage(4096+i*4096);assert(view);s->views.push_back(*view);}
     s->cache->device_tracker.markings=0;
     auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
     assert(s->cache->PollControlledRegistration(op)==Phase::Cancelled);
     assert(s->gpu.submissions==0 && s->cache->device_tracker.markings==0);}
    {auto s=std::make_unique<Scenario>();
     auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
     {std::unique_lock lock{s->cache->device_memory.epoch->mutex};
      assert(s->cache->PollControlledRegistration(op)==Phase::Admitted);
      assert(s->cache->device_tracker.markings==0);}
     assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);}
    for(int fault=0;fault<7;++fault) {
        auto s=std::make_unique<Scenario>();
        assert(s->cpu.Write<u8>(s->views.front(),4103,77)==Result::Stored);
        auto op=s->cache->BeginControlledFirstRegistration(A,1,s->views);assert(op);
        assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);
        if(fault==0) s->gpu.submit_result=VK_ERROR_DEVICE_LOST;
        if(fault==6) s->gpu.corrupt=true;
        s->scheduler.RunWorker();s->gpu.Complete();
        if(fault==0) s->gpu.counter=999; // Later ticks never excuse this submit's own failure.
        if(fault==1) {s->gpu.counter_result=VK_ERROR_DEVICE_LOST;s->gpu.counter=999;}
        if(fault==2) s->gpu.invalidate_result=VK_ERROR_MEMORY_MAP_FAILED;
        if(fault==3) {++s->cache->device_memory.epoch->generation;s->cache->device_memory.remapped=true;}
        if(fault==4) s->cache->ReuseHidden(op);
        if(fault==5) s->gpu.wait_result=VK_ERROR_DEVICE_LOST;
        assert(s->cache->PollControlledRegistration(op)==Phase::Unknown);
        assert(!s->cache->IsRegionRegistered(A,C) && s->cache->ControlledReadyBuffer(op)==NULL_BUFFER_ID);
        assert(!op->BeginCachedWrite());
        auto physical=s->views.front().physical;
        const auto domain=physical.Epoch()->ranges;
        const std::array access{Common::PhysicalRangeAdmission::Access{0,4096,Common::PhysicalRangeAdmission::Mode::Read}};
        auto reader=domain->Enqueue(access,std::make_shared<int>(1));assert(reader);
        assert(domain->TryStart(reader)==Common::PhysicalRangeAdmission::Start::Park);
        assert(domain->Cancel(reader));
    }
}
void readback_exclusion() {
    using Request=Core::Memory::ControlledCpuWriteRequest;
    for(unsigned mode=0;mode<5;++mode) {
        auto s=std::make_unique<Scenario>();
        auto op=s->cache->BeginControlledFirstRegistration(A+7,1,s->views);assert(op);
        assert(s->cache->PollControlledRegistration(op)==Phase::Submitted);s->finish(op);
        Core::Memory::Memory memory{&s->cpu};
        auto request=memory.PrepareControlledWrite8(4096+7,77);assert(request);
        // Other device alias, other page, same coarse physical preservation footprint.
        const auto alias=ALIAS+C-4096;
        if(mode==0) s->cache->uncommitted_gpu_modified_ranges.Add(alias,1);
        if(mode==1) {s->cache->committed_gpu_modified_ranges.emplace_back();
            s->cache->committed_gpu_modified_ranges.back().Add(alias,1);}
        if(mode==2) s->cache->pending_downloads.push_back({{BufferCopy{alias,0,1}}});
        if(mode==3) s->cache->pending_downloads.push_back({{BufferCopy{ALIAS+C,0,1}}});
        std::unique_lock mapping{s->cache->device_memory.mapping_guard,std::defer_lock};
        if(mode==4) mapping.lock();
        auto tx=s->cache->BeginControlledCpuWriteRequest(op,request);
        if(mode==3) {
            assert(tx && request->State()==Request::Phase::Accepted);
            s->cache->AbandonControlledCpuWrite(tx); // No store; retain accepted identity.
        } else if(tx || request->State()!=Request::Phase::Cancelled ||
                  s->backing(7)!=10 || s->gpu.submissions!=1 || op->State()!=Phase::Ready) {
            std::cerr<<"readback conflict accepted before producer retirement\n";std::exit(95);
        }
    }
    std::cout<<"PASS pre-accept readback exclusion: uncommitted/committed/native pending, physical alias, coarse footprint, busy mapping and disjoint queue\n";
}

int main(int argc,char** argv) {
    {
        MultiAddressContainer aliases;const auto first=aliases.Register(1);
        for(u32 i=2;i<=64;++i) aliases.Register(i,first);
        std::array<u32,64> values{};size_t count{};
        assert(aliases.GatherValuesBounded(first,values,count) && count==64);
        aliases.Register(65,first);
        assert(!aliases.GatherValuesBounded(first,values,count));
        assert(!aliases.GatherValuesBounded(0,values,count));
    }
    const int repeats=argc>1?std::atoi(argv[1]):1;
    for(int i=0;i<repeats;++i) {
        writer_first(1);writer_first(15);registration_first();
        for(u64 width: {1,2,4,8}) {production_write_transaction(width);production_write_transaction(width,true);}
    }
    faults();transaction_faults();ordinary_binding_refusals();request_lifecycle();scheduler_handoff();enqueue_close_and_teardown();readback_exclusion();
    std::cout<<"PASS actual cache pipeline: both 77 registration orderings, GPU dirty complement [99,77,99], transaction upload exclusion, post-store real tracker publication, delayed checked native completion and failure/drop quarantine; repeat="<<repeats<<" (Vulkan dispatch/device execution remain fixtures)\n";
}
