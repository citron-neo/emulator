    void BreakDestinationDependencyForTest(const Transfer& transfer, const Transfer& wrong) {transfer->replica_destination=wrong;}
    void BreakReplicaQueueIdentityForTest(const Transfer& transfer) {transfer->submission->queue=reinterpret_cast<VkQueue>(uintptr_t{99});}
    Transfer ForgeReplicaForTest(const Transfer& parent, bool wrong_geometry) {
        auto plan = ReplicaCopyProvenance::Build(parent->content, 0, 1, 16, 16, 16, 64, 0, 16, 1, 0);
        assert(plan);
        const std::array<TransferBuffer,2> buffers{parent->resources[wrong_geometry ? 0 : 2], parent->resources[1]};
        const std::array<TransferContent::Command,1> commands{{{TransferContent::Kind::Copy,1,0,wrong_geometry ? 0u : 16u,16,16}}};
        return RecordTransferBatchImpl(buffers,commands,std::make_shared<const ReplicaCopyProvenance>(std::move(*plan)),parent);
    }
    void BreakReplicaSyncForTest(const Transfer& transfer, int mode) {
        auto& journal = transfer->submission->synchronization;
        journal = {};
        const VkMemoryBarrier entry{VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_MEMORY_WRITE_BIT,
            mode == 3 ? VkAccessFlags{VK_ACCESS_TRANSFER_WRITE_BIT} : VkAccessFlags{VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT}};
        const VkMemoryBarrier release{VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr,
            VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
            mode == 5 ? VkAccessFlags{VK_ACCESS_MEMORY_READ_BIT} : VkAccessFlags{VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT}};
        if (mode != 0) journal.RecordBarrier(mode == 2 ? VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT : VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
                                             VK_PIPELINE_STAGE_TRANSFER_BIT, entry);
        transfer->positions[0] = journal.RecordAccess();
        if (mode != 1) journal.RecordBarrier(mode == 4 ? VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT : VK_PIPELINE_STAGE_TRANSFER_BIT,
                                             VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, release);
    }
