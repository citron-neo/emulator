    u64 NextTick() {return tick++;}
    VkResult SubmitQueue(vk::CommandBuffer& main,vk::CommandBuffer& upload,VkSemaphore signal,VkSemaphore wait,u64 value) {
        return SubmitQueueTimeline(main,upload,signal,wait,value);
    }
    VkResult SubmitQueueTimeline(vk::CommandBuffer&,vk::CommandBuffer&,VkSemaphore,VkSemaphore,u64);
    // @POLL_TIMELINE@
};
class Scheduler {
