    u64 generation{},bias{};bool hole{};
    template<class F> auto ReadPhysicalMappingSnapshot(F&& callback) const {
        epoch->generation.store(generation);
        return callback(epoch,generation,backing,u64{4*1024*1024},[&](u64 address)->std::optional<u64> {
            if(hole) return {};
            return address%131072+bias;
        });
    }
};
