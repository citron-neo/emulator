namespace VideoCommon {
template<class P> class BufferCache {
public:
    using Buffer=Vulkan::Buffer;using Runtime=Vulkan::BufferCacheRuntime;
    Runtime& runtime;
    std::mutex mutex; // Same cache-lock type; producer locking is explicit in handoff tests.
    DeviceTracker device_tracker;
    VideoCommon::MemoryTrackerBase<DeviceTracker> memory_tracker;
    struct DeviceMemory {
        Common::HostMemory& backing;
        Common::MappingLifetime mapping_lifetime;
        std::shared_ptr<Common::MappingEpoch> epoch=mapping_lifetime.Get();
        std::mutex& mapping_guard=epoch->mutex;
        std::shared_ptr<const Common::GuestBackingEpoch> backing_epoch=backing.BackingEpoch();
        std::function<void()> on_pin;
        u64 MapGeneration() const {return epoch->generation.load();}
        bool remapped=false;
        template<class F> auto ReadPhysicalMappingSnapshot(F f) const {
            std::scoped_lock lock{epoch->mutex};
            return f(std::shared_ptr<const Common::MappingEpoch>{epoch},epoch->generation.load(),
                backing.BackingEpoch(),backing.backing_size,[&](u64 address)->std::optional<u64> {
                    if(address<A || address>=A+C) return {};
                    return address-A+(remapped?C:0);
                });
        }
        auto PinGuestPhysicalRange(u64 offset,u64 size,const auto& epoch_) const {
            if(on_pin) on_pin();
            assert(epoch_==backing.BackingEpoch());return backing.PinPhysicalRange(offset,size);
        }
        auto PrepareGuestPhysicalCpuPage(u64 offset,const auto& epoch_) const {
            assert(epoch_==backing.BackingEpoch());return backing.PreparePhysicalCpuPage(offset);
        }
        bool CollectControlledAliasesLocked(u64 physical,std::span<DAddr> output,size_t& count) const {
            if(output.size()<2) return false;
            output[0]=A+physical;output[1]=ALIAS+physical;count=2;return true;
        }
        // @DEVICE_WRITE_GUARDS@
    } device_memory;
    Common::SlotVector<Buffer> slot_buffers;
    Lru lru_cache;
    u64 frame_tick=0,total_used_memory=0,buffer_count=0,large_buffer_memory=0,large_buffer_count=0;
    static constexpr u64 LARGE_BUFFER_THRESHOLD=8ULL<<20,CACHING_PAGESIZE=C;
    bool scatter_busy=false;struct Gather {bool scatter_pending=false;};std::map<u64,Gather> gather_buffers;
    std::map<u64,BufferId> page_table;
    // @REGISTRATION_CLASS@
    std::vector<ControlledRegistrationPtr> controlled_registrations;
    Common::RangeSet<DAddr> uncommitted_gpu_modified_ranges;
    std::deque<Common::RangeSet<DAddr>> committed_gpu_modified_ranges;
    // Controlled exclusion must also retain copies whose valid byte ranges were cancelled.
    struct PendingDownload { std::vector<BufferCopy> copies; };
    std::deque<PendingDownload> pending_downloads;
    BufferCache(Cpu& cpu,Runtime& runtime_):runtime{runtime_},device_tracker{cpu},memory_tracker{device_tracker},
        device_memory{cpu.system.device.buffer} {(void)slot_buffers.insert(runtime,0,C);}
    bool IsRegionPageTableAddressable(u64 address,u64 size) const {return size && address<1ULL<<39 && size<=(1ULL<<39)-address;}
    BufferId GetPageBufferId(u64 page) const {
        auto it=page_table.find(page);return it==page_table.end()?BufferId{}:it->second;
    }
    void SetPageBufferId(u64 page,BufferId id) {page_table[page]=id;}
    bool IsRegionRegistered(u64 address,u64 size) const {return size && bool(GetPageBufferId(address/C)) && bool(GetPageBufferId((address+size-1)/C));}
    void NotifyGatherWrite(u64,u64) {}
    Common::RangeSet<DAddr> gpu_modified_ranges;
    void ClearDownload(u64,u64) {} // Pending async download container collaborator.
    void CheckControlledSynchronization(DAddr,u64);
    bool ControlledReadbacksIdle(const ControlledRegistrationPtr&);
    bool SynchronizeBuffer(Buffer&,DAddr,u32);
    bool IsDirectGuest(Buffer&) {return false;}
    void EndGuestCpuAccess(Buffer&) {}
    void GuestMemoryBarrier(bool) {assert(false);}
    void UploadMemory(Buffer&,u64,u64,std::span<VideoCommon::BufferCopy>) {assert(false);}
    void MarkGpuUse(Buffer&,u64,u64) {} // Usage/renderer collaborators, not completion evidence.
    void DeleteBuffer(BufferId id,bool) {Unregister(id);slot_buffers.erase(id);} // Binding teardown fixture.
    void Register(BufferId);void Unregister(BufferId);
    template<bool insert> void ChangeRegister(BufferId);
    ControlledRegistrationPtr BeginControlledFirstRegistration(DAddr,u32,std::span<const Core::Memory::PreparedCpuPage>);
    typename ControlledRegistration::Phase PollControlledRegistration(const ControlledRegistrationPtr&);
    bool BeginControlledRefresh(const ControlledRegistrationPtr&);
    BufferId ControlledReadyBuffer(const ControlledRegistrationPtr&);
    BufferId ControlledBufferId(const ControlledRegistrationPtr&,bool,bool=false);
    template<class Store> Result CommitControlledCpuWrite(Common::PhysicalRegistrationBundle::CachedWrite&,std::span<const DAddr>,u64,Store&&);
    template<class Store> Result CommitControlledCachedWrite(const ControlledRegistrationPtr&,
        const Core::Memory::PreparedCpuPage&,Common::PhysicalRegistrationBundle::CachedWrite&,u64,u64,Store&&);
    ControlledCpuWritePtr BeginControlledCpuWrite(const ControlledRegistrationPtr&,const Core::Memory::PreparedCpuPage&,u64,u64,std::shared_ptr<const void> = {});
    ControlledCpuWritePtr BeginControlledCpuWriteRequest(const ControlledRegistrationPtr&,const Core::Memory::ControlledCpuWriteRequestPtr&);
    template<class Execute> Result CommitControlledCpuWriteRequest(const ControlledCpuWritePtr&,Execute&&);
    void AbandonControlledCpuWrite(const ControlledCpuWritePtr&);
    typename ControlledCpuWrite::Phase PollControlledCpuWrite(const ControlledCpuWritePtr&);
    template<class Store> Result CommitControlledCpuTransaction(const ControlledCpuWritePtr&,u64,Store&&);
    void ReuseHidden(const ControlledRegistrationPtr& op) {
        auto id=op->id;slot_buffers.erase(id);auto replacement=slot_buffers.insert(runtime,op->address,C);assert(replacement==id);
