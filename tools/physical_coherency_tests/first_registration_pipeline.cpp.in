struct Semaphore {
    explicit operator bool() const {return true;}
    VkResult GetCounterChecked(u64& value) const {value=driver->counter;return driver->counter_result;}
    VkResult WaitChecked(u64 tick,u64 timeout) const {
        assert(timeout==0);
        return driver->wait_result!=VK_SUCCESS?driver->wait_result:
            (driver->counter>=tick?VK_SUCCESS:VK_TIMEOUT);
    }
    VkSemaphore operator*() const {return reinterpret_cast<VkSemaphore>(uintptr_t{1});}
};
struct Queue {
    VkQueue Handle() const {return reinterpret_cast<VkQueue>(driver->queue_id);}
    VkResult Submit(const VkSubmitInfo& info) {
        ++driver->submissions;
        if(driver->submit_result!=VK_SUCCESS) {
            if(driver->uncertain_submit_effects) {for(auto& command:driver->recorded) driver->submitted.push_back(std::move(command));driver->recorded.clear();}
            return driver->submit_result;
        }
        const auto* timeline=static_cast<const VkTimelineSemaphoreSubmitInfo*>(info.pNext);
        assert(timeline && timeline->signalSemaphoreValueCount==1);
        driver->submitted_tick=timeline->pSignalSemaphoreValues[0];
        for (auto& command : driver->recorded) driver->submitted.push_back(std::move(command));
        driver->recorded.clear(); // Multiple accepted submissions preserve queue order until Complete.
        return VK_SUCCESS;
    }
};
struct Device {
    bool timeline=true;
    bool HasDebuggingToolAttached() const {return false;}
    bool HasTimelineSemaphore() const {return timeline;}
    Queue GetGraphicsQueue() const {return {};}
    void ReportLoss() const {++driver->reported_losses;}
};
