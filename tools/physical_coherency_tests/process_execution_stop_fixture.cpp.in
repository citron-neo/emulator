using namespace std::chrono_literals;
namespace Common {
struct PageTable {};
// Allocation collaborator only. The separate backing-storage suite links real HostMemory.
class HostMemory {
public:
    std::shared_ptr<const GuestBackingEpoch> epoch=std::make_shared<GuestBackingEpoch>();
    std::shared_ptr<int> allocation=std::make_shared<int>(77);
    auto BackingEpoch() {return epoch;}
    std::optional<RetainedBackingStorage> RetainBackingStorage() const {
        if(!allocation || !epoch || !epoch->alive) return std::nullopt;
        return RetainedBackingStorage{allocation,epoch,4096};
    }
};
}
namespace Core {
struct Debugger {
    template<class... T> void NotifyThreadStopped(T&&...) {}
    template<class... T> void NotifyThreadWatchpoint(T&&...) {}
};
class System {
public:
    struct Device {
        Common::HostMemory buffer;
    } device;
    Debugger debugger;
    bool DebuggerEnabled() {return false;}
    Debugger& GetDebugger() {return debugger;}
    Device& DeviceMemory() {return device;}
};
struct SchedulerTestAccess {
    static auto HoldRoster(Kernel::ProcessOwnerRoster& roster) {
        return std::unique_lock{roster.state->mutex};
    }
    static auto HoldCore( Kernel::PhysicalCore& core) {return std::unique_lock{core.m_guard};}
    static bool Running(Kernel::PhysicalCore& core) {
        std::scoped_lock lock{core.m_guard};return core.m_arm_interface!=nullptr;
    }
};
}
struct Backend final : Core::ArmInterface {
    std::atomic<unsigned> runs{},stores{},locks{},unlocks{},initializations{},requests{};
    std::atomic<bool> halt{},running{};
    bool supported=true,svc=false,throws=false;
    std::promise<void>* unlock_entered{};
    std::shared_future<void> unlock_release;
    std::function<void()> on_request;
    void Initialize() override {++initializations;}
    void LockThread(Kernel::KThread*) override {++locks;}
    void UnlockThread(Kernel::KThread*) override {
        ++unlocks;
        if(unlock_entered) {unlock_entered->set_value();unlock_release.wait();}
    }
    Core::HaltReason RunThread(Kernel::KThread*) override {
        ++runs;running=true;++stores;
        if(throws) throw std::runtime_error("injected backend exception");
        if(svc) return Core::HaltReason::SupervisorCall;
        while(!halt.load()) std::this_thread::yield();
        ++stores; // A final store after halt REQUEST, before acknowledgement.
        return Core::HaltReason::BreakLoop;
    }
    Core::HaltReason StepThread(Kernel::KThread* thread) override {return RunThread(thread);}
    void SignalInterrupt(Kernel::KThread*) override {halt=true;}
    bool RequestNonblockingGuestStop(Kernel::KThread* thread) override {
        if(on_request) on_request();
        ++requests;if(!supported) return false;SignalInterrupt(thread);return true;
    }
};
namespace Kernel {
class KernelCore {
public:
    struct Impl {
        std::array<std::unique_ptr<Kernel::PhysicalCore>,Core::Hardware::NUM_CPU_CORES> cores;
        std::unique_ptr<Common::ProducerDrain> guest_process_initialization=
            std::make_unique<Common::ProducerDrain>();
        ProcessOwnerRoster process_owners;
        std::shared_ptr<Common::ProducerDrain> process_publications=
            std::make_shared<Common::ProducerDrain>();
        std::shared_ptr<Common::ProducerDrain> managed_guest_writes=
            std::make_shared<Common::ProducerDrain>();
        std::shared_ptr<Common::ProducerDrain> audio_render=
            std::make_shared<Common::ProducerDrain>();
        std::shared_ptr<Common::ProducerDrain> audio_callbacks=
            std::make_shared<Common::ProducerDrain>();
        std::shared_ptr<Common::ProducerDrain> host1x_submits=
            std::make_shared<Common::ProducerDrain>();
        std::shared_ptr<Common::ProducerDrain> nvdrv_dispatch=
            std::make_shared<Common::ProducerDrain>();
    };
    Core::System system;
    std::unique_ptr<Impl> impl=std::make_unique<Impl>();
    KernelCore() {for(size_t i=0;i<impl->cores.size();++i) impl->cores[i]=std::make_unique<Kernel::PhysicalCore>(*this,i);}
    bool IsMulticore() {return true;}
    Core::System& System() {return system;}
    Kernel::PhysicalCore& PhysicalCore(size_t index) {return *impl->cores.at(index);}
    std::optional<GuestExecutionDrain> TryCloseGuestExecution(u32 poll_budget) @CLOSE@
    std::optional<Common::ProducerDrain::Entry> TryEnterGuestProcessInitialization() @INIT_ENTER@
    std::optional<Common::ProducerDrain::Closure> TryCloseGuestProcessInitialization(u32 poll_budget) @INIT_CLOSE@
    std::optional<ProcessOwnerRoster::Snapshot> TryRetainProcessOwners() @OWNERS@
    std::optional<ProcessOwnerRoster::CreationClosure> TryCloseProcessCreation() @CREATION@
    const std::shared_ptr<Common::ProducerDrain>& ProcessPublicationDomain() const @PUBLICATIONS@
    const std::shared_ptr<Common::ProducerDrain>& ManagedGuestWriteDomain() const {return impl->managed_guest_writes;}
    const std::shared_ptr<Common::ProducerDrain>& AudioRenderDomain() const {return impl->audio_render;}
    const std::shared_ptr<Common::ProducerDrain>& AudioCallbackDomain() const {return impl->audio_callbacks;}
    const std::shared_ptr<Common::ProducerDrain>& Host1xSubmitDomain() const {return impl->host1x_submits;}
    const std::shared_ptr<Common::ProducerDrain>& NvdrvDispatchDomain() const {return impl->nvdrv_dispatch;}
};
struct PageTable {
    Common::PageTable table;
    bool HasImpl() const {return true;}
    Common::PageTable& GetImpl() {return table;}
    Common::PageTable& GetImpl() const {return const_cast<Common::PageTable&>(table);}
};
class KProcess {
public:
    enum class State {Running,Terminated};
    KernelCore& m_kernel;PageTable m_page_table;Backend backend;
    std::atomic<unsigned> refs{1};bool initialized=true;State state=State::Running;
    std::function<void()> on_close;
    u64 registration;
    explicit KProcess(KernelCore& kernel):m_kernel{kernel},registration{kernel.impl->process_owners.Register(this)} {}
    ~KProcess() {m_kernel.impl->process_owners.Remove(registration);}
    bool Open() {++refs;return true;}
    void Close() {--refs;if(on_close) on_close();}
    bool IsInitialized() const {return initialized;}
    State GetState() const {return state;}
    PageTable& GetPageTable() {return m_page_table;}
    const PageTable& GetPageTable() const {return m_page_table;}
    Core::ArmInterface* GetArmInterface(size_t) {return &backend;}
    std::optional<ProcessExecutionStop> TryStopGuestExecution(u32 poll_budget=64);
    std::optional<ProcessCohortStop> TryStopProcessCohort(u32 poll_budget=64);
};
enum class StepState {None,StepPending,StepPerformed};
enum class SuspendType {Debug};
class KThread {
public:
    KProcess& process;StepState step{};
    explicit KThread(KProcess& owner):process{owner} {}
    KProcess* GetOwnerProcess() {return &process;}
    bool HasDpc() {return false;}
    bool IsTerminationRequested() {return false;}
    [[noreturn]] void Exit() {std::abort();}
    StepState GetStepState() {return step;}
    void SetStepState(StepState value) {step=value;}
    void RequestSuspend(SuspendType) {}
};
namespace Svc {
inline std::function<void()> callback;
void Call(Core::System&,unsigned) {if(callback) callback();}
}
PhysicalCore::PhysicalCore(KernelCore& kernel,size_t index):m_kernel{kernel},m_core_index{index} {}
PhysicalCore::~PhysicalCore()=default;
// @RUN@
// @INTERRUPT@
// @REQUEST@
// @FACTORY@
// @STOP_METHODS@
}
template<class Predicate> void Until(Predicate predicate) {
    const auto end=std::chrono::steady_clock::now()+2s;
    while(!predicate()) {assert(std::chrono::steady_clock::now()<end);std::this_thread::yield();}
}
int main() {
    using R=Kernel::ProcessExecutionStop::Result;
    { // A pre-existing initializer/rollback remains part of the stop obligation.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};
        Kernel::KThread thread{process};
        std::thread cpu{[&] {kernel.PhysicalCore(0).RunThread(&thread);}};
        Until([&] {return process.backend.running.load();});
        auto initializing=kernel.TryEnterGuestProcessInitialization();assert(initializing);
        auto stop=process.TryStopGuestExecution(8);assert(stop);
        assert(!kernel.TryEnterGuestProcessInitialization());
        const auto pending=stop->Poll();
        assert(process.backend.requests==0 && "initialization must drain before halt request");
        assert(pending==R::Pending && "initialization must drain before backend acknowledgement");
        assert(!stop->CancelNoEffects());
        assert(!kernel.TryEnterGuestProcessInitialization());
        initializing.reset();
        (void)stop->Poll();cpu.join();
        assert(stop->Poll()==R::BackendsStopped && stop->CancelNoEffects());
        assert(kernel.TryEnterGuestProcessInitialization());
        auto next=process.TryStopGuestExecution();assert(next);
        assert(!stop->CancelNoEffects() && !kernel.TryEnterGuestProcessInitialization());
        assert(next->Poll()==R::BackendsStopped && next->CancelNoEffects());
    }
    { // Uncertain initialization cannot be reopened by a late rollback exit/destructor.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};
        auto initializing=kernel.TryEnterGuestProcessInitialization();assert(initializing);
        auto stop=process.TryStopGuestExecution(1);assert(stop);
        assert(stop->Poll()==R::Unknown);
        initializing.reset();
        assert(stop->Poll()==R::Unknown && !stop->CancelNoEffects());
        stop.reset();
        assert(!kernel.TryEnterGuestProcessInitialization());
    }
    { // Another initializer closure refuses before any core closure effect.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};
        auto closed=kernel.TryCloseGuestProcessInitialization(8);assert(closed);
        assert(!process.TryStopGuestExecution());
        auto core=kernel.PhysicalCore(0).TryCloseGuestExecution(8);assert(core);
        assert(core->Poll()==Common::ProducerDrain::Result::DrainedSubset);
        assert(core->ResumeNoEffects());
        assert(closed->ResumeNoEffects());
    }
    { // The requester does not own either running core; a caller-only pin is insufficient.
        Kernel::KernelCore kernel;
        Kernel::KProcess caller{kernel},first{kernel},second{kernel};
        Kernel::KThread one{first},two{second};
        {
            Kernel::KScopedAutoObject<Kernel::KProcess> occupied{&caller};
            assert(kernel.PhysicalCore(0).TryRequestGuestStop(occupied)==
                   Kernel::PhysicalCore::StopRequest::Unsupported);
            assert(caller.refs==2); // Refusal preserves the supplied owner and core entry state.
        }
        std::promise<void> unlocking_one,unlocking_two,release;
        auto released=release.get_future().share();
        first.backend.unlock_entered=&unlocking_one;first.backend.unlock_release=released;
        second.backend.unlock_entered=&unlocking_two;second.backend.unlock_release=released;
        first.backend.on_request=[&] {
            assert(first.refs==2 && "running backend owner must be retained before halt request");
        };
        second.backend.on_request=[&] {
            assert(second.refs==2 && "running backend owner must be retained before halt request");
        };
        std::thread cpu_one{[&] {kernel.PhysicalCore(0).RunThread(&one);}};
        std::thread cpu_two{[&] {kernel.PhysicalCore(2).RunThread(&two);}};
        Until([&] {return first.backend.running && second.backend.running;});
        auto stop=caller.TryStopGuestExecution(4096);assert(stop && caller.refs==2);
        assert(stop->Poll()==R::Pending && "halt request must not acknowledge running backend");
        unlocking_one.get_future().wait();unlocking_two.get_future().wait();
        assert(first.refs==2 && second.refs==2);
        auto moved=std::make_optional(std::move(*stop));stop.reset();
        assert(first.refs==2 && second.refs==2 && caller.refs==2);
        release.set_value();cpu_one.join();cpu_two.join();
        assert(moved->Poll()==R::BackendsStopped && moved->CancelNoEffects());
        assert(first.refs==2 && second.refs==2); // Held through the request lifetime.
        moved.reset();
        assert(first.refs==1 && second.refs==1 && caller.refs==1);
    }
    for(bool step:{false,true}) { // Actual Run/Step: request is not acknowledgement.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};Kernel::KThread thread{process};
        thread.step=step ? Kernel::StepState::StepPending : Kernel::StepState::None;
        auto& core=kernel.PhysicalCore(0);
        std::promise<void> unlocking,release;process.backend.unlock_entered=&unlocking;
        process.backend.unlock_release=release.get_future().share();
        std::thread cpu{[&] {core.RunThread(&thread);}};
        Until([&] {return process.backend.running.load();});
        auto stop=process.TryStopGuestExecution(4096);assert(stop && process.refs==2);
        assert(stop->Poll()==R::Pending && "halt request must not acknowledge running backend");
        unlocking.get_future().wait();
        assert(stop->Poll()==R::Pending && "backend scope must retain through UnlockThread");
        release.set_value();cpu.join();
        assert(stop->Poll()==R::BackendsStopped && !Core::SchedulerTestAccess::Running(core));
        assert(process.backend.stores==2 && process.backend.locks==1 && process.backend.unlocks==1);
        const auto inits=process.backend.initializations.load();core.RunThread(&thread);
        assert(process.backend.runs==1 && process.backend.initializations==inits);
        assert(stop->GuestBackingAdmission()==Common::ProducerDrain::Result::Unknown);
        assert(stop->CancelNoEffects());
        auto next=process.TryStopGuestExecution();assert(next);
        assert(!stop->CancelNoEffects());
        assert(next->Poll()==R::BackendsStopped && next->CancelNoEffects());
    }
    { // Actual SVC callback remains a writer AFTER real backend exit: mandatory negative control.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};Kernel::KThread thread{process};
        process.backend.svc=true;std::promise<void> in_svc,release;auto wait=release.get_future();
        unsigned service_writes=0;
        Kernel::Svc::callback=[&] {in_svc.set_value();wait.wait();++service_writes;};
        std::thread cpu{[&] {kernel.PhysicalCore(0).RunThread(&thread);}};
        in_svc.get_future().wait();auto stop=process.TryStopGuestExecution();assert(stop);
        assert(stop->Poll()==R::BackendsStopped &&
               "backend acknowledgement must not count a suspended SVC fiber");
        assert(stop->GuestBackingAdmission()==Common::ProducerDrain::Result::Unknown);
        release.set_value();cpu.join();assert(service_writes==1);
        assert(stop->CancelNoEffects());Kernel::Svc::callback={};
    }
    { // Unsupported (e.g. blocking NCE signal handshake) is sticky Unknown, never synthetic success.
        Kernel::KernelCore kernel;Kernel::KProcess caller{kernel},process{kernel};Kernel::KThread thread{process};
        process.backend.supported=false;
        process.backend.on_request=[&] {
            assert(process.refs==2 && "running backend owner must be retained before halt request");
        };
        std::thread cpu{[&] {kernel.PhysicalCore(0).RunThread(&thread);}};
        Until([&] {return process.backend.running.load();});
        auto stop=caller.TryStopGuestExecution();assert(stop);
        assert(stop->Poll()==R::Unknown && !stop->CancelNoEffects());
        assert(process.refs==2);
        kernel.PhysicalCore(0).Interrupt();cpu.join();
        assert(stop->Poll()==R::Unknown && !stop->CancelNoEffects());
        assert(process.refs==2); // A late backend exit cannot drop the captured foreign owner.
    }
    { // No wait on a core lock; budget exhaustion keeps closure quarantined.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};
        auto stop=process.TryStopGuestExecution(1);assert(stop);
        auto lock=Core::SchedulerTestAccess::HoldCore(kernel.PhysicalCore(2));
        assert(stop->Poll()==R::Pending);assert(stop->Poll()==R::Unknown);
        lock.unlock();assert(!stop->CancelNoEffects());
    }
    { // Moved-from and backing retirement cannot release another operation's closure.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};
        auto original=process.TryStopGuestExecution();assert(original);
        auto moved=std::move(*original);
        assert(original->Poll()==R::Unknown && !original->CancelNoEffects());
        assert(moved.Poll()==R::BackendsStopped);
        kernel.system.device.buffer.epoch=std::make_shared<Common::GuestBackingEpoch>();
        assert(moved.Poll()==R::Unknown && !moved.CancelNoEffects());
    }
    { // The epoch is not storage: replacement must keep the old allocation alive.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};
        auto& buffer=kernel.system.device.buffer;
        std::weak_ptr<int> old=buffer.allocation;
        auto stop=process.TryStopGuestExecution();assert(stop);
        process.on_close=[&] {
            if(process.refs==0)
                assert(!old.expired() && "backing owner must outlive process finalization");
        };
        process.Close(); // Transfer the final process reference to the request.
        buffer.allocation=std::make_shared<int>(99);
        buffer.epoch=std::make_shared<Common::GuestBackingEpoch>();
        assert(!old.expired() && "process stop must retain actual backing storage");
        assert(stop->Poll()==R::Unknown && !stop->CancelNoEffects());
        assert(!old.expired());stop.reset();assert(old.expired());
    }
    { // A stopped latch must not hide a later initialization/domain Seal.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};
        auto stop=process.TryStopGuestExecution();assert(stop&&stop->Poll()==R::BackendsStopped);
        kernel.impl->guest_process_initialization->Seal();
        assert(stop->Poll()==R::Unknown && "stopped latch must observe a later Seal");
        assert(!stop->CancelNoEffects()&&!kernel.PhysicalCore(0).TryCloseGuestExecution(8));
    }
    { // Failed storage capture precedes every core closure or owner reference.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};
        kernel.system.device.buffer.allocation.reset();
        assert(!process.TryStopGuestExecution() && process.refs==1);
        auto close=kernel.TryCloseGuestExecution(64);assert(close);
        assert(close->Poll()==Common::ProducerDrain::Result::DrainedSubset && close->CancelNoEffects());
    }
    { // Exception still clears context and releases execution scope, never content admission.
        Kernel::KernelCore kernel;Kernel::KProcess process{kernel};Kernel::KThread thread{process};
        process.backend.throws=true;bool threw=false;
        try {kernel.PhysicalCore(0).RunThread(&thread);} catch(const std::runtime_error&) {threw=true;}
        assert(threw && !Core::SchedulerTestAccess::Running(kernel.PhysicalCore(0)));
        assert(process.backend.unlocks==1);auto stop=process.TryStopGuestExecution();assert(stop);
        assert(stop->Poll()==R::BackendsStopped && stop->CancelNoEffects());
    }
    std::cout<<"PASS actual backend scope, real stop entry/request bodies, SVC omitted-writer control, process retention and sticky uncertainty; injected backend, no native ARM proof\n";
}
