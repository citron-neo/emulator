using namespace std::chrono_literals;
void Require(bool ok,const char* why){if(!ok){std::cerr<<"FAIL "<<why<<'\n';std::cerr.flush();std::_Exit(91);}}
struct Event{std::mutex mutex;std::condition_variable cv;bool ready=false;
    void Set(){std::scoped_lock l{mutex};ready=true;cv.notify_all();}
    void Wait(){std::unique_lock l{mutex};Require(cv.wait_for(l,5s,[&]{return ready;}),"rendezvous timeout");}};
template<class T>T Ready(std::future<T>& f){Require(f.wait_for(5s)==std::future_status::ready,"future timeout");return f.get();}
struct Trace{
    std::atomic<int> lookups=0,publications=0,conductors=0,manager_calls=0,composes=0;
    bool gpu_drained=false;std::function<void()> lookup_hook;
};
template<class T>using Out=T*;
template<class T>using OutCopyHandle=T**;
template<class T,int>using OutLargeData=T*;
constexpr int BufferAttr_HipcMapAlias=0;
struct ClientAppletResourceUserId{u64 pid=1;};
namespace Common{template<class T>struct Rectangle{T left{},top{},right{},bottom{};};}
namespace Kernel{struct KProcess{};struct KReadableEvent{};}
namespace Service::android{struct Fence{};}
namespace Service::VI {struct Container;struct SharedBufferManager;}
namespace Service::Nvidia{struct Module{};struct NVDRV{std::shared_ptr<Module> module=std::make_shared<Module>();auto GetModule(){return module;}};}
namespace Service::Nvnflinger {
struct SurfaceFlinger{std::shared_ptr<Trace> trace;void AddDisplay(u64){++trace->publications;}void RemoveDisplay(u64){}
    bool ComposeDisplay(s32*,f32*,u64){++trace->composes;return true;}};
struct IHOSBinderDriver{std::shared_ptr<SurfaceFlinger> surface;auto GetSurfaceFlinger(){return surface;}};
}
struct System{
    std::shared_ptr<Trace> trace=std::make_shared<Trace>();
    struct Services{
        std::shared_ptr<Trace> trace;
        std::shared_ptr<Service::Nvnflinger::IHOSBinderDriver> binder;
        std::shared_ptr<Service::Nvidia::NVDRV> nvdrv=std::make_shared<Service::Nvidia::NVDRV>();
        template<class T>std::shared_ptr<T> GetService(const char*,bool){++trace->lookups;if(trace->lookup_hook)trace->lookup_hook();
            if constexpr(std::is_same_v<T,Service::Nvnflinger::IHOSBinderDriver>)return binder;else return nvdrv;}
    } services{trace,std::make_shared<Service::Nvnflinger::IHOSBinderDriver>(Service::Nvnflinger::IHOSBinderDriver{
        std::make_shared<Service::Nvnflinger::SurfaceFlinger>(Service::Nvnflinger::SurfaceFlinger{trace})})};
    auto& ServiceManager(){return services;}
};
namespace Service::VI {
namespace Nvidia=Service::Nvidia;namespace Nvnflinger=Service::Nvnflinger;
constexpr int ResultOperationFailed=1;
constexpr int ResultPermissionDenied=5;
struct SharedMemoryPoolLayout{};
struct Display{u64 GetId(){return 1;}};
struct Displays{template<class F>void ForEachDisplay(F f){Display display;f(display);}};
struct Layer{u64 GetId(){return 1;}};
struct Layers{template<class F>void ForEachLayer(F f){Layer layer;f(layer);}};
struct SharedBufferManager{
    std::shared_ptr<Trace> trace;std::shared_ptr<Nvidia::Module> module;
    SharedBufferManager(System& s,Container&,std::shared_ptr<Nvidia::Module> m):trace{s.trace},module{std::move(m)}{}
    template<class... T>int CreateSession(T&&...){++trace->manager_calls;return 0;}
    template<class... T>void DestroySession(T&&...){++trace->manager_calls;}
    template<class... T>int GetSharedBufferMemoryHandleId(T&&...){++trace->manager_calls;return 0;}
    template<class... T>int AcquireSharedFrameBuffer(T&&...){++trace->manager_calls;return 0;}
    template<class... T>int PresentSharedFrameBuffer(T&&...){++trace->manager_calls;return 0;}
    template<class... T>int GetSharedFrameBufferAcquirableEvent(T&&...){++trace->manager_calls;return 0;}
    template<class... T>int CancelSharedFrameBuffer(T&&...){++trace->manager_calls;return 0;}
    template<class... T>int WriteAppletCaptureBuffer(T&&...){++trace->manager_calls;return 0;}
};
struct Conductor{Conductor(System& s,Container&,Displays&){++s.trace->conductors;}void Stop(){}};
struct Mutex{std::mutex actual;std::atomic<bool> held=false;std::function<void()> before_lock;
    void lock(){auto hook=before_lock;if(hook)hook();actual.lock();held=true;}void unlock(){held=false;actual.unlock();}};
struct Container{
    std::mutex m_termination_lock;Mutex m_lock;Displays m_displays;Layers m_layers;
    std::shared_ptr<Nvnflinger::IHOSBinderDriver> m_binder_driver;
    std::shared_ptr<Nvnflinger::SurfaceFlinger> m_surface_flinger;
    std::optional<SharedBufferManager> m_shared_buffer_manager;
    std::optional<Conductor> m_conductor;
    System& m_system;bool m_is_initialized=false,m_is_shut_down=false;
    explicit Container(System& s):m_system{s}{}
    int DestroyLayerLocked(u64){return 0;}
    // @DECLARATIONS@
};
// @METHODS@
