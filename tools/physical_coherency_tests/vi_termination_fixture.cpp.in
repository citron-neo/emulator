using Service::VI::Container;
template<class C>bool Init(C& c){if constexpr(std::is_same_v<decltype(c.EnsureInitialized()),bool>)return c.EnsureInitialized();else{c.EnsureInitialized();return true;}}
void Cold(){System system;Container container{system};container.OnTerminate();
    Require(!Init(container) && system.trace->lookups==0 && system.trace->publications==0 && system.trace->conductors==0,
            "terminated cold VI published providers");
    Require(container.GetSharedBufferManager()==nullptr,"terminated VI borrowed shared manager");}
void Late(){System system;const auto container=std::make_shared<Container>(system);std::stop_source source;auto token=source.get_token();
    // @STOP_CALLBACK@
    Event entered,release;std::atomic<int> visits=0;
    system.trace->lookup_hook=[&]{if(++visits==1){
        Require(!container->m_lock.held,"VI initialization held publication lock across lookup");
        entered.Set();release.Wait();}};
    auto init=std::async(std::launch::async,[&]{return Init(*container);});entered.Wait();
    source.request_stop();Require(container->m_is_shut_down,"stop callback did not close VI");
    // Model the owning System's next GPU drain, after synchronous stop callbacks.
    system.trace->gpu_drained=true;release.Set();const bool initialized=Ready(init);
    Require(!initialized && system.trace->publications==0 && system.trace->conductors==0 && !container->m_shared_buffer_manager,
            "late VI initialization published after stop and GPU drain");
    Require(container->GetSharedBufferManager()==nullptr,"late init exposed shared manager");}
void Retained(){System system;auto retained=std::make_shared<Container>(system);Require(Init(*retained),"normal setup failed");
    auto module=retained->m_shared_buffer_manager->module;const int before=system.trace->lookups;
    retained->OnTerminate();system.trace->gpu_drained=true;
    Require(!Init(*retained) && retained->GetSharedBufferManager()==nullptr && system.trace->lookups==before,
            "retained terminated VI lent session entry");
    Require(module && retained->m_shared_buffer_manager && retained->m_shared_buffer_manager->module==module,
            "terminal refusal released retained session provider");}
void Normal(){System system;Container container{system};Require(Init(container) && Init(container),"normal init refused");
    Require(container.GetSharedBufferManager()!=nullptr && system.trace->conductors==1 && system.trace->publications==1 && system.trace->lookups==2,
            "normal init lost or duplicated provider");}
void Concurrent(){System system;Container container{system};Event entered,release;std::atomic<int> visits=0;
    system.trace->lookup_hook=[&]{if(++visits==1){entered.Set();release.Wait();}};
    auto first=std::async(std::launch::async,[&]{return Init(container);});entered.Wait();
    Require(Init(container),"second initializer failed");release.Set();Require(Ready(first),"existing winner not reused");
    Require(system.trace->conductors==1 && system.trace->publications==1,"competing initializer duplicated worker");}
void EntryRaces(){for(int route=0;route<3;++route){System system;Container c{system};Require(Init(c),"setup failed");int locks=0;
    c.m_lock.before_lock=[&]{if(++locks==2)c.OnTerminate();};
    if(route==0)Require(c.GetSharedBufferManager()==nullptr,"accessor lent manager after termination won second lock");
    if(route==1){auto before=system.services.binder;auto out=before;Require(c.GetBinderDriver(&out)==1 && out==before,
        "binder accessor published after termination won second lock");}
    if(route==2){s32 interval=77;f32 speed=9;Require(!c.ComposeOnDisplay(&interval,&speed,1) && system.trace->composes==0,
        "composition ran after termination won second lock");}
}}
void Unavailable(){System s;Container c{s};auto binder=s.services.binder;s.services.binder.reset();
    Require(!Init(c) && !c.m_shared_buffer_manager && s.trace->conductors==0,"missing provider fabricated initialization");
    s.services.binder=binder;Require(Init(c),"no-effect provider refusal prevented retry");}
void Callers(bool closed){System s;auto c=std::make_shared<Container>(s);Require(Init(*c),"setup failed");if(closed)c->OnTerminate();
    auto manager=std::make_shared<Service::VI::IManagerDisplayService>();manager->m_container=c;
    Service::VI::ISystemDisplayService service{c};Service::AM::DisplayLayerManager am;am.m_display_service=manager;
    Kernel::KProcess process;u64 buffer=77,layer=78,size=79;s32 handle=80;Service::VI::SharedMemoryPoolLayout layout;
    Service::android::Fence fence;std::array<s32,4> slots{};long long slot=81;Kernel::KReadableEvent* event=nullptr;bool written=false;s32 index=82;
    const int expected=closed?1:0;
    Require(manager->CreateSharedLayerSession(&process,&buffer,&layer,1,false)==expected,"create caller mishandled terminal refusal");
    manager->DestroySharedLayerSession(&process);
    Require(service.GetSharedBufferMemoryHandleId(&handle,&size,&layout,1,{1})==expected,"handle caller mishandled terminal refusal");
    Require(service.AcquireSharedFrameBuffer(&fence,&slots,&slot,1)==expected,"acquire caller mishandled terminal refusal");
    Require(service.PresentSharedFrameBuffer(fence,{},0,1,1,0)==expected,"present caller mishandled terminal refusal");
    Require(service.GetSharedFrameBufferAcquirableEvent(&event,1)==expected,"event caller mishandled terminal refusal");
    Require(service.CancelSharedFrameBuffer(1,0)==expected,"cancel caller mishandled terminal refusal");
    Require(am.WriteAppletCaptureBuffer(&written,&index)==expected,"capture caller mishandled terminal refusal");
    Require(s.trace->manager_calls==(closed?0:8),"service callers lost or replayed manager operations");
    if(closed)Require(buffer==77 && layer==78 && size==79 && handle==80 && slot==81 && !written && index==82,
        "terminal service refusal changed outputs");
}
int main(int argc,char** argv){Require(argc==2,"missing case");std::string name=argv[1];
    if(name=="cold")Cold();else if(name=="late")Late();else if(name=="retained")Retained();else if(name=="normal")Normal();else if(name=="concurrent")Concurrent();
    else if(name=="entry-races")EntryRaces();else if(name=="unavailable")Unavailable();else if(name=="closed-callers")Callers(true);else if(name=="open-callers")Callers(false);else return 98;
    std::cout<<"PASS VI terminal publication "<<name<<'\n';}
