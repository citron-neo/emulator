    std::shared_ptr<Container> m_container;
    auto GetContainer(){return m_container;}
    // @MANAGER_DECLARATIONS@
};
struct ISystemDisplayService{
    std::shared_ptr<Container> m_container;
    // @SYSTEM_DECLARATIONS@
};
// @SERVICE_METHODS@
}
