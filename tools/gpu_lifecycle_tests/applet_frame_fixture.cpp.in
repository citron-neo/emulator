#include <algorithm>
#include <array>
#include <atomic>
#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <functional>
#include <iterator>
#include <memory>
#include <list>
#include <optional>
#include <semaphore>
#include <span>
#include <stdexcept>
#include <string>
#include <thread>
#include <type_traits>
#include <utility>
#include <vector>
#include <vulkan/vulkan.h>
#include "common/terminal_fail_stop.h"
using u8=unsigned char;using u64=unsigned long long;using u32=uint32_t;
static void check(bool b,const char* s){if(!b){std::fprintf(stderr,"FAIL %s\n",s);std::fflush(stderr);std::_Exit(91);}}
static void event(const char* s){std::fprintf(stderr,"EVENT %s\n",s);std::fflush(stderr);}
static std::string fault,paused;
static bool host_failure{},gate_used{};
static std::binary_semaphore entered{0},release_gate{0};
static std::array<int,3> creates{},releases{};
static int next_id=1,draws{},downloads{},records{},finishes{},idle_calls{},pass_creates{};
static std::vector<int> release_order,last_layers;
static std::function<void()> observe;
struct State{int kind,id,children{};bool live=true;std::shared_ptr<State> parent;};
static std::vector<std::shared_ptr<State>> states;
static void factory_gate(const char* stage){
    if(observe)observe();
    if(paused==stage&&!gate_used){gate_used=true;entered.release();release_gate.acquire();}
}
namespace Vulkan {
namespace vk {
struct Exception:std::exception{VkResult GetResult()const{return VK_ERROR_OUT_OF_DEVICE_MEMORY;}};
template<class Handle,int Kind>struct Resource{
    std::shared_ptr<State> state;
    Resource()=default;
    explicit Resource(std::shared_ptr<State> s):state{std::move(s)}{}
    Resource(const Resource&)=delete;Resource&operator=(const Resource&)=delete;
    Resource(Resource&&r)noexcept:state{std::move(r.state)}{}
    Resource&operator=(Resource&&r)noexcept{Reset();state=std::move(r.state);return *this;}
    ~Resource(){Reset();}
    void Reset()noexcept{if(state){check(state->children==0,"parent destroyed before child");state->live=false;if(state->parent)--state->parent->children;++releases[Kind];release_order.push_back(Kind);event(Kind==0?"image.destroy":Kind==1?"view.destroy":"framebuffer.destroy");state.reset();}}
    explicit operator bool()const{return bool(state);}
    Handle operator*()const{return state?reinterpret_cast<Handle>(static_cast<uintptr_t>(state->id)):nullptr;}
};
using Image=Resource<VkImage,0>;using ImageView=Resource<VkImageView,1>;using Framebuffer=Resource<VkFramebuffer,2>;
struct CommandBuffer{};struct Semaphore{};struct Fence{};
struct Buffer{
    mutable std::array<u8,16> bytes{};
    VkBuffer operator*()const{return reinterpret_cast<VkBuffer>(reinterpret_cast<uintptr_t>(this));}
    void Invalidate()const{check(finishes>0,"readback before completion");bytes.fill(0x6a);}
    std::span<u8> Mapped()const{return bytes;}
};
}
@FRAME@
static void maybe_fail(const char* stage){if(fault==stage){if(host_failure)throw std::bad_alloc();throw vk::Exception{};}}
static std::shared_ptr<State> make(int kind,std::shared_ptr<State> parent={}){
    if(parent){check(parent->live,"native parent not live");++parent->children;}
    auto s=std::make_shared<State>(State{kind,next_id++,0,true,std::move(parent)});states.push_back(s);return s;
}
static std::shared_ptr<State> lookup(VkImageView handle){
    auto id=reinterpret_cast<uintptr_t>(handle);
    for(auto&s:states)if(static_cast<uintptr_t>(s->id)==id&&s->live&&s->kind==1)return s;
    check(false,"framebuffer view missing");return {};
}
struct Device{
    struct Logical{vk::Framebuffer CreateFramebuffer(const VkFramebufferCreateInfo& info)const{
        ++creates[2];factory_gate("framebuffer");maybe_fail("framebuffer");
        return vk::Framebuffer(make(2,lookup(*info.pAttachments)));
    }}logical;
    const Logical& GetLogical()const{return logical;}
};
struct MemoryAllocator{};
enum class MemoryUsage{Download};
struct Scheduler{
    std::vector<std::function<void(vk::CommandBuffer)>> work;
    void RequireNativeBorrowAdmission()const{}
    void RequestOutsideRenderPassOperationContext(){}
    template<class F>void Record(F f){++records;work.push_back(f);}
    void FinishNativeBorrow(){++finishes;auto pending=std::move(work);work.clear();for(auto&f:pending)f({});}
};
}
namespace Tegra {struct FramebufferConfig{u64 owner_aruid{};bool is_applet{};int z_index{},id{};};}
namespace Layout {struct FramebufferLayout{unsigned width=2,height=2;};}
namespace VideoCore::Capture {constexpr unsigned LinearWidth=2,LinearHeight=2,BytesPerPixel=4;const Layout::FramebufferLayout Layout{};}
namespace Vulkan {
constexpr VkExtent2D CaptureImageSize{2,2};constexpr VkExtent3D CaptureImageExtent{2,2,1};constexpr VkFormat CaptureFormat=VK_FORMAT_R8G8B8A8_UNORM;
struct Filters{int value=1;int get_scaling_filter()const{return value;}};
struct Pass{VkRenderPass GetRenderPass()const{return reinterpret_cast<VkRenderPass>(123);}};
struct BlitScreen{
    Device device;Filters filters;int scaling_filter=1;VkFormat swapchain_view_format=CaptureFormat;std::unique_ptr<Pass> window_adapt;
    Scheduler scheduler;std::list<int>layers;
    std::unique_ptr<Pass>CreateWindowAdaptPass(int,VkFormat){++pass_creates;factory_gate("pass");maybe_fail("pass");return std::make_unique<Pass>();}
    void WaitIdle(){++idle_calls;}
    void SetWindowAdaptPass(){++pass_creates;factory_gate("pass");maybe_fail("pass");window_adapt=std::make_unique<Pass>();}
    vk::Framebuffer CreateFramebuffer(const Layout::FramebufferLayout&,VkImageView,VkFormat);
    vk::Framebuffer CreateFramebuffer(const VkImageView&,VkExtent2D,VkRenderPass);
    void DrawToFrame(int&,Frame*frame,std::span<const Tegra::FramebufferConfig> layers,const Layout::FramebufferLayout&,int,VkFormat){
        check(frame->image&&frame->image_view&&frame->framebuffer&&frame->width==2&&frame->height==2,"draw observed incomplete frame");
        check(frame->image_view.state->parent==frame->image.state&&frame->framebuffer.state->parent==frame->image_view.state,"draw mismatched frame parents");
        ++draws;last_layers.clear();for(auto&layer:layers)last_layers.push_back(layer.id);maybe_fail("draw");
    }
};
@BLIT@
static vk::Image CreateWrappedImage(MemoryAllocator&,VkExtent2D,VkFormat){++creates[0];factory_gate("image");maybe_fail("image");return vk::Image(make(0));}
static vk::ImageView CreateWrappedImageView(const Device&,vk::Image& image,VkFormat){++creates[1];factory_gate("view");maybe_fail("view");check(bool(image),"view parent missing");return vk::ImageView(make(1,image.state));}
static vk::Buffer CreateWrappedBuffer(MemoryAllocator&,size_t,MemoryUsage){return {};}
static void DownloadColorImage(vk::CommandBuffer&,VkImage image,VkBuffer,VkExtent3D){check(image!=VK_NULL_HANDLE,"readback image missing");++downloads;}
struct RendererVulkan{
    Device device;MemoryAllocator memory_allocator;BlitScreen blit_applet;Scheduler scheduler;int rasterizer{};Frame applet_frame{};
    @CONTENT_STATE@
    u64 GetMainApplicationAruid()const{return 42;}
    void RenderAppletCaptureLayer(std::span<const Tegra::FramebufferConfig>);
    std::vector<u8> GetAppletCaptureBuffer();
};
@RENDERER@
}
constexpr bool has_content_state = @HAS_CONTENT_STATE@;
constexpr bool transactional_pass = @TRANSACTIONAL_PASS@;
static bool empty(const Vulkan::Frame&frame){return !frame.width&&!frame.height&&!frame.image&&!frame.image_view&&!frame.framebuffer;}
int main(int argc,char**argv){
    if(argc!=2)return 2;
    const std::string mode=argv[1];
    std::atexit([]{event("atexit");});
    const std::array<Tegra::FramebufferConfig,4> layers{{{42,true,3,1},{9,false,2,2},{42,false,10,3},{0,false,0,4}}};
    {
        Vulkan::RendererVulkan renderer;
        auto attempt=[&]{try{renderer.RenderAppletCaptureLayer(layers);return false;}catch(const Vulkan::vk::Exception&){return true;}catch(const std::bad_alloc&){return true;}};
        auto inspect_failure=[&]{
            check(empty(renderer.applet_frame),"partial frame published");
            check(draws==0&&records==0&&downloads==0,"construction failure emitted use");
            auto data=renderer.GetAppletCaptureBuffer();check(data.size()==16&&std::ranges::all_of(data,[](u8 b){return b==0;}),"partial frame readback exposed");
            check(records==0&&downloads==0&&finishes==0,"empty capture emitted readback");
            for(auto&s:states)check(!s->live,"candidate prefix leaked");
        };
        if(mode=="empty"||mode=="filtered"){
            const std::array<Tegra::FramebufferConfig,1> no_applet{{{42,false,100,5}}};
            if(mode=="empty")renderer.RenderAppletCaptureLayer({});else renderer.RenderAppletCaptureLayer(no_applet);
            inspect_failure();check(creates==std::array<int,3>{},"empty input allocated");
            std::fprintf(stderr,"PASS %s\n",argv[1]);return 0;
        }
        if(mode=="sequence"){
            for(auto stage:{"image","view","framebuffer"}){fault=stage;check(attempt(),"missing injected failure");inspect_failure();}
        }else if(mode!="normal"&&mode!="reuse"&&mode!="sort"){
            auto dash=mode.find('-');fault=dash==std::string::npos?mode:mode.substr(dash+1);
            host_failure=mode.starts_with("host-");
            if(mode.starts_with("gate-")){
                paused=fault;bool failed=false;
                std::jthread owner([&]{failed=attempt();});entered.acquire();
                check(empty(renderer.applet_frame),"partial frame visible at factory gate");
                release_gate.release();owner.join();check(failed,"missing gated failure");
            }else check(attempt(),"missing injected failure");
            if(mode=="draw"||mode=="host-draw"){
                check(renderer.applet_frame.image&&renderer.applet_frame.image_view&&renderer.applet_frame.framebuffer,"draw failure lost published frame");
                if constexpr(has_content_state){
                    const auto before=creates;const int old_draws=draws;fault.clear();
                    check(renderer.GetAppletCaptureBuffer().empty(),"failed draw readback admitted");
                    renderer.RenderAppletCaptureLayer(layers);
                    check(creates==before&&draws==old_draws,"failed draw replayed");
                    std::fprintf(stderr,"PASS %s\n",argv[1]);return 0;
                }
            }else if(mode.starts_with("retry-")){
                fault.clear();renderer.RenderAppletCaptureLayer(layers);
                check(renderer.applet_frame.image&&renderer.applet_frame.image_view&&renderer.applet_frame.framebuffer,"retry left partial frame");
            }else{
                if(mode.starts_with("readback-")){
                    const auto before_records=records;auto data=renderer.GetAppletCaptureBuffer();
                    check(records==before_records&&std::ranges::all_of(data,[](u8 b){return b==0;}),"partial frame readback exposed");
                }
                inspect_failure();
            }
        }
        fault.clear();paused.clear();host_failure=false;
        if(!draws)renderer.RenderAppletCaptureLayer(layers);
        check(renderer.applet_frame.image&&renderer.applet_frame.image_view&&renderer.applet_frame.framebuffer,"successful creation not published");
        check(last_layers==std::vector<int>({2,1}),"applet filtering or order changed");
        const int expected_passes=(mode=="pass"||mode=="host-pass"||mode=="gate-pass"||(transactional_pass&&(mode.find("framebuffer")!=std::string::npos||mode=="sequence")))?2:1;
        check(pass_creates==expected_passes&&idle_calls==expected_passes,"helper retry side effects changed");
        const auto before=creates;const int old_draws=draws;auto image=renderer.applet_frame.image.state;
        renderer.RenderAppletCaptureLayer(layers);
        check(creates==before&&draws==old_draws+1&&renderer.applet_frame.image.state==image,"complete frame not reused");
        auto output=renderer.GetAppletCaptureBuffer();
        check(output.size()==16&&std::ranges::all_of(output,[](u8 b){return b==0x6a;})&&downloads==1&&finishes==1,"normal readback semantics changed");
        observe={};
    }
    for(auto&s:states)check(!s->live,"frame leaked after disposal");
    check(release_order.size()>=3&&std::vector<int>(release_order.end()-3,release_order.end())==std::vector<int>({2,1,0}),"frame disposal order changed");
    std::fprintf(stderr,"PASS %s\n",argv[1]);
}
